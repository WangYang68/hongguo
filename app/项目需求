#### **C. 高精度演奏调度**

为了满足"高要求、和弦、低延迟"的需求：

```kotlin
class PerformanceScheduler {
    private val eventQueue = PriorityQueue<MidiEvent>()
    private var handler: Handler? = null

    fun schedule(events: List<MidiEvent>) {
        // 按时间戳排序
        events.forEach { eventQueue.add(it) }

        // 使用 Choreographer 实现帧级别精度
        startScheduling()
    }

    private fun startScheduling() {
        handler = Handler(Looper.getMainLooper())
        scheduleNextEvent()
    }

    private fun scheduleNextEvent() {
        val nextEvent = eventQueue.peek() ?: return

        val currentTime = SystemClock.uptimeMillis()
        val delay = nextEvent.timestamp - currentTime

        if (delay <= 0) {
            // 立即执行
            executeEvent(eventQueue.poll())
            scheduleNextEvent()
        } else {
            // 延迟执行（精度控制在1ms以内）
            handler?.postDelayed({
                executeEvent(eventQueue.poll())
                scheduleNextEvent()
            }, delay)
        }
    }

    private fun executeEvent(event: MidiEvent) {
        when (event) {
            is NoteOn -> dispatchClick(event.keyCoordinate)
            is NoteOff -> dispatchRelease(event.keyCoordinate)
        }
    }
}
```


**优化手段**：
1. 使用 `Handler.postDelayed` 而非 `Thread.sleep`（更高精度）
2. 预加载所有坐标到内存，避免查询数据库
3. 批量发送手势（Android 7.0+ 支持 `dispatchGesture`）
4. 使用 `Choreographer` 同步到屏幕刷新率

#### **D. 无障碍服务实现**

```kotlin
class PianoAccessibilityService : AccessibilityService() {

    override fun onAccessibilityEvent(event: AccessibilityEvent?) {
        // 监听目标应用启动
        if (event?.packageName == TARGET_PACKAGE) {
            // 自动识别琴键坐标
            autoDetectPianoKeys()
        }
    }

    fun dispatchClick(x: Int, y: Int) {
        // 方法1：使用 GestureDescription（Android 7.0+）
        val gesture = GestureDescription.Builder()
            .addStroke(
                GestureDescription.StrokeDescription(
                    Path().apply { moveTo(x.toFloat(), y.toFloat()) },
                    0,  // 开始时间
                    50L // 持续时间（毫秒）
                )
            )
            .build()

        dispatchGesture(gesture, null, null)

        // 方法2：备用方案 - performGlobalAction
        // 但精度不如 GestureDescription
    }
}
```


