<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/floating_player_bg"
    android:padding="14dp"
    android:elevation="16dp">

    <!-- 拖动条 -->
    <LinearLayout
        android:id="@+id/dragHandle"
        android:layout_width="match_parent"
        android:layout_height="14dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">
        <View
            android:layout_width="40dp"
            android:layout_height="5dp"
            android:background="#30FFFFFF" />
    </LinearLayout>

    <!-- 标题 + 进度 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🎹 坐标标定"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvProgressBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0/2"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/btn_speed_active_bg"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp" />
    </LinearLayout>

    <!-- 步骤提示 -->
    <TextView
        android:id="@+id/tvStep"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="点击「标定左边界」开始"
        android:textColor="#B0B0B0"
        android:textSize="12sp"
        android:layout_marginBottom="12dp"
        android:lineSpacingMultiplier="1.3" />

    <!-- 标定按钮 -->
    <LinearLayout
        android:id="@+id/btnCalibrate"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center"
        android:background="@drawable/calibration_btn_bg"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/btn_calibrate_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="标定左边界"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 完成/取消 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center">

        <LinearLayout
            android:id="@+id/btnFinish"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/calibration_btn_finish_bg"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓ 完成"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/calibration_btn_cancel_bg"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✕ 取消"
                android:textColor="#FF6B6B"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
