"""
VideoPreview — VLC 专业播放器
基于 python-vlc / libvlc，内置解码器，全格式兼容
【开发状态：已完成】
"""

import os
import sys
import ctypes
from PyQt6.QtWidgets import (
    QWidget, QVBoxLayout, QHBoxLayout, QLabel,
    QPushButton, QSlider, QMessageBox,
)
from PyQt6.QtCore import Qt, QTimer, pyqtSignal

from app.theme import COLORS
from app.utils.file_utils import format_duration


def _find_vlc_lib() -> str | None:
    """查找 libvlc.dll，先检查常见安装路径"""
    paths = [
        os.path.join(os.environ.get("PROGRAMFILES", "C:\\Program Files"), "VideoLAN", "VLC"),
        os.path.join(os.environ.get("ProgramFiles(x86)", "C:\\Program Files (x86)"), "VideoLAN", "VLC"),
        r"C:\Program Files\VideoLAN\VLC",
        r"C:\Program Files (x86)\VideoLAN\VLC",
    ]
    for p in paths:
        dll = os.path.join(p, "libvlc.dll")
        if os.path.exists(dll):
            return p
    # 尝试 PATH
    import shutil
    vlc_exe = shutil.which("vlc")
    if vlc_exe:
        return os.path.dirname(vlc_exe)
    return None


class VideoPreview(QWidget):
    """VLC 视频播放器"""

    duration_loaded = pyqtSignal(float)

    def __init__(self, parent=None):
        super().__init__(parent)
        self._filepath = ""
        self._duration = 0.0
        self._vlc = None
        self._player = None
        self._media = None
        self._seeking = False
        self._ready = False
        self._init_ui()
        self._init_timer()

    def _init_ui(self):
        layout = QVBoxLayout(self)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.setSpacing(6)

        self._video_frame = QLabel("🎬 请加载视频")
        self._video_frame.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self._video_frame.setMinimumHeight(300)
        self._video_frame.setStyleSheet(f"""
            QLabel {{ background-color: #000; border: 1px solid {COLORS['border']};
            border-radius: 8px; color: {COLORS['text_muted']}; font-size: 18px; }}
        """)
        layout.addWidget(self._video_frame, 1)

        ctrl = QHBoxLayout(); ctrl.setSpacing(10)

        self._play_btn = QPushButton("▶")
        self._play_btn.setFixedSize(44, 44)
        self._play_btn.setCursor(Qt.CursorShape.PointingHandCursor)
        self._play_btn.clicked.connect(self._toggle_play)
        self._play_btn.setStyleSheet(f"""
            QPushButton {{ background-color: {COLORS['accent']}; color: #fff;
            border-radius: 22px; font-size: 22px; font-weight: bold; }}
            QPushButton:hover {{ background-color: {COLORS['accent_hover']}; }}
        """)
        ctrl.addWidget(self._play_btn)

        self._time_label = QLabel("00:00 / 00:00")
        self._time_label.setStyleSheet(
            f"color:{COLORS['text_secondary']};font-size:13px;font-weight:500;min-width:120px;")
        ctrl.addWidget(self._time_label)

        self._seek = QSlider(Qt.Orientation.Horizontal)
        self._seek.setRange(0, 10000)
        self._seek.sliderPressed.connect(self._seek_press)
        self._seek.sliderReleased.connect(self._seek_release)
        self._seek.sliderMoved.connect(self._seek_move)
        ctrl.addWidget(self._seek, 1)

        layout.addLayout(ctrl)

    def _init_timer(self):
        self._timer = QTimer(self)
        self._timer.setInterval(200)
        self._timer.timeout.connect(self._refresh)

    # ===== VLC 加载 =====
    def _init_vlc(self):
        if self._vlc:
            return True
        dll_dir = _find_vlc_lib()
        if not dll_dir:
            return False
        try:
            os.add_dll_directory(dll_dir) if sys.platform == "win32" else None
            import vlc
            self._vlc = vlc.Instance()
            self._player = self._vlc.media_player_new()
            # 嵌入到 QLabel
            win_id = int(self._video_frame.winId())
            if sys.platform == "win32":
                self._player.set_hwnd(win_id)
            elif sys.platform == "darwin":
                self._player.set_nsobject(win_id)
            else:
                self._player.set_xwindow(win_id)
            return True
        except Exception:
            return False

    # ===== 公开方法 =====
    def load_video(self, filepath: str):
        self._filepath = filepath
        self._ready = False
        if not os.path.exists(filepath):
            return
        if not self._init_vlc():
            self._video_frame.setText("❌ VLC 未安装\n\n请安装 VLC media player\nhttps://www.videolan.org/vlc/")
            return

        self._player.stop()
        abs_path = os.path.abspath(filepath).replace("\\", "/")
        self._media = self._vlc.media_new(f"file:///{abs_path}")
        self._player.set_media(self._media)

        # 播放一帧后暂停以获取时长
        self._player.play()
        QTimer.singleShot(600, self._on_loaded)

    def _on_loaded(self):
        if self._player:
            dur = self._player.get_length()
            self._duration = dur / 1000.0 if dur > 0 else 0
            self._ready = True
            self._player.pause()
            self._timer.start()
            self._refresh()
            self.duration_loaded.emit(self._duration)

    def set_position(self, sec: float):
        if self._player:
            self._player.set_time(int(sec * 1000))

    def get_position(self) -> float:
        return (self._player.get_time() / 1000.0) if self._player else 0.0
    def get_duration(self) -> float:
        return self._duration

    # ===== 播放控制 =====
    def _toggle_play(self):
        if not self._player or not self._ready:
            return
        import vlc
        state = self._player.get_state()
        if state in (vlc.State.Playing, vlc.State.Buffering):
            self._player.pause()
            self._play_btn.setText("▶")
        else:
            self._player.play()
            self._play_btn.setText("⏸")

    def _refresh(self):
        if not self._player or not self._ready:
            return
        try:
            import vlc
            dur = self._player.get_length()
            pos = self._player.get_time()
            if dur > 0:
                self._duration = dur / 1000.0
            state = self._player.get_state()
            if not self._seeking:
                val = int(pos / max(dur, 1) * 10000)
                self._seek.blockSignals(True)
                self._seek.setValue(val)
                self._seek.blockSignals(False)
            self._time_label.setText(f"{format_duration(pos/1000)} / {format_duration(max(dur,1)/1000)}")
            if state == vlc.State.Ended:
                self._play_btn.setText("▶")
            elif state in (vlc.State.Playing, vlc.State.Buffering):
                self._play_btn.setText("⏸")
        except Exception:
            pass

    # ===== Seek =====
    def _seek_press(self): self._seeking = True
    def _seek_release(self):
        self._seeking = False
        if self._player:
            val = self._seek.value()
            self._player.set_time(int(val / 10000.0 * max(self._player.get_length(), 1)))
    def _seek_move(self, val):
        dur = self._player.get_length() if self._player else 1
        self._time_label.setText(f"{format_duration(val/10000*dur/1000)} / {format_duration(max(dur,1)/1000)}")

    # ===== 清理 =====
    def _release(self):
        self._timer.stop()
        if self._player:
            self._player.stop()
            self._player.release()
            self._player = None
        if self._vlc:
            self._vlc.release()
            self._vlc = None

    def closeEvent(self, e):
        self._release()
        super().closeEvent(e)
