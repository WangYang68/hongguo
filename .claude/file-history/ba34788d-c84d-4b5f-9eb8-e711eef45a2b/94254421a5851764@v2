"""
EffectRegistry — 特效自动注册表
所有 BaseEffect 子类在导入时自动注册
【开发状态：已完成】
"""

from app.effects.base import BaseEffect


class EffectRegistry:
    """管理所有可用特效"""
    _effects: dict[str, type[BaseEffect]] = {}
    _by_category: dict[str, list[str]] = {}

    @classmethod
    def register(cls, effect_cls: type[BaseEffect]):
        """注册一个特效类"""
        name = effect_cls.name
        cat = effect_cls.category
        cls._effects[name] = effect_cls
        cls._by_category.setdefault(cat, []).append(name)

    @classmethod
    def get(cls, name: str) -> type[BaseEffect] | None:
        return cls._effects.get(name)

    @classmethod
    def all_names(cls) -> list[str]:
        return list(cls._effects.keys())

    @classmethod
    def all_categories(cls) -> dict[str, list[str]]:
        """返回 {分类名: [特效名列表]}"""
        return dict(cls._by_category)

    @classmethod
    def instantiate(cls, name_or_dict) -> BaseEffect | None:
        """从名称或 dict 创建特效实例"""
        if isinstance(name_or_dict, dict):
            type_name = name_or_dict.get("type", "")
            cls_ = cls.get(type_name)
            if cls_:
                return cls_.from_dict(name_or_dict)
        elif isinstance(name_or_dict, str):
            cls_ = cls.get(name_or_dict)
            if cls_:
                return cls_()
        return None

    @classmethod
    def clear(cls):
        cls._effects.clear()
        cls._by_category.clear()


# 自动注册元类 — 子类定义后自动加入注册表
class AutoRegisterMeta(type):
    """元类：BaseEffect 的子类自动注册到 EffectRegistry"""
    def __new__(mcs, name, bases, namespace):
        cls = super().__new__(mcs, name, bases, namespace)
        if name != "BaseEffect" and "BaseEffect" in [b.__name__ for b in bases]:
            EffectRegistry.register(cls)
        return cls
