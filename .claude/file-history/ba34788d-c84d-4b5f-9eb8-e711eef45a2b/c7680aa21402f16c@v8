"""
VideoPreview — 专业视频播放器
内置 3 级回退：OpenCV → QMediaPlayer → FFmpeg 缩略图
【开发状态：已完成】
"""

import os
import subprocess
import sys
from PyQt6.QtWidgets import (
    QWidget, QVBoxLayout, QHBoxLayout, QLabel,
    QPushButton, QSlider,
)
from PyQt6.QtCore import Qt, QUrl, QTimer, pyqtSignal
from PyQt6.QtGui import QImage, QPixmap
from PyQt6.QtMultimedia import QMediaPlayer, QAudioOutput

from app.theme import COLORS
from app.settings import FFMPEG_PATH
from app.utils.file_utils import format_duration

# 尝试加载 OpenCV
try:
    import cv2
    HAS_CV2 = True
except ImportError:
    cv2 = None
    HAS_CV2 = False


class VideoPreview(QWidget):
    """OpenCV 帧解码 + QMediaPlayer 音频  |  全格式兼容"""

    duration_loaded = pyqtSignal(float)

    def __init__(self, parent=None):
        super().__init__(parent)
        self._filepath = ""
        self._duration = 0.0
        self._fps = 30.0
        self._width = 640
        self._height = 360
        self._position = 0.0
        self._playing = False
        self._seeking = False
        self._cap = None
        self._audio_player = None
        self._mode = "opencv"  # opencv | qtmedia | thumbnail
        self._init_ui()
        self._init_timer()

    def _init_ui(self):
        layout = QVBoxLayout(self)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.setSpacing(6)

        self._frame_label = QLabel("📺 请加载视频")
        self._frame_label.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self._frame_label.setMinimumHeight(300)
        self._frame_label.setStyleSheet(f"""
            QLabel {{ background-color: #000; border: 1px solid {COLORS['border']};
            border-radius: 8px; color: {COLORS['text_muted']}; font-size: 16px; }}
        """)
        layout.addWidget(self._frame_label, 1)

        ctrl = QHBoxLayout(); ctrl.setSpacing(10)

        self._play_btn = QPushButton("▶")
        self._play_btn.setFixedSize(42, 42)
        self._play_btn.setCursor(Qt.CursorShape.PointingHandCursor)
        self._play_btn.clicked.connect(self._toggle_play)
        self._play_btn.setStyleSheet(f"""
            QPushButton {{ background-color: {COLORS['accent']}; color: #fff;
            border-radius: 21px; font-size: 20px; font-weight: bold; }}
            QPushButton:hover {{ background-color: {COLORS['accent_hover']}; }}
        """)
        ctrl.addWidget(self._play_btn)

        self._time_label = QLabel("00:00 / 00:00")
        self._time_label.setStyleSheet(
            f"color:{COLORS['text_secondary']};font-size:13px;font-weight:500;min-width:120px;")
        ctrl.addWidget(self._time_label)

        self._seek = QSlider(Qt.Orientation.Horizontal)
        self._seek.setRange(0, 10000)
        self._seek.sliderPressed.connect(self._seek_press)
        self._seek.sliderReleased.connect(self._seek_release)
        self._seek.sliderMoved.connect(self._seek_move)
        ctrl.addWidget(self._seek, 1)

        layout.addLayout(ctrl)

    def _init_timer(self):
        self._refresh_timer = QTimer(self)
        self._refresh_timer.setInterval(33)  # ~30fps
        self._refresh_timer.timeout.connect(self._refresh_frame)

    # ===== 公开 =====
    def load_video(self, filepath: str):
        self._filepath = filepath
        self._playing = False; self._refresh_timer.stop(); self._release()
        if not os.path.exists(filepath): return

        # 1) 尝试 OpenCV
        if HAS_CV2:
            self._cap = cv2.VideoCapture(filepath)
            if self._cap.isOpened():
                self._fps = self._cap.get(cv2.CAP_PROP_FPS) or 30
                frames = self._cap.get(cv2.CAP_PROP_FRAME_COUNT)
                self._duration = frames / self._fps if self._fps > 0 else 0
                self._width = int(self._cap.get(cv2.CAP_PROP_FRAME_WIDTH))
                self._height = int(self._cap.get(cv2.CAP_PROP_FRAME_HEIGHT))
                self._mode = "opencv"
                self._setup_audio(filepath)
                self._position = 0; self._show_opencv_frame(0)
                self._update_time()
                self.duration_loaded.emit(self._duration)
                return

        # 2) 回退: QMediaPlayer(音频) + FFmpeg pipe(帧)
        self._mode = "qtmedia"
        self._setup_audio(filepath)
        self._probe_duration(filepath)
        self._show_ffmpeg_frame(0)
        self._update_time()
        self.duration_loaded.emit(self._duration)

    def _setup_audio(self, filepath: str):
        try:
            self._audio_player = QMediaPlayer()
            audio = QAudioOutput(); self._audio_player.setAudioOutput(audio)
            self._audio_player.setSource(QUrl.fromLocalFile(os.path.abspath(filepath)))
        except Exception:
            self._audio_player = None

    def _probe_duration(self, filepath: str):
        import json
        ffprobe = FFMPEG_PATH.replace("ffmpeg", "ffprobe")
        try:
            proc = subprocess.run([ffprobe,"-v","quiet","-print_format","json","-show_format",filepath],
                capture_output=True, encoding="utf-8", errors="replace", timeout=10,
                creationflags=subprocess.CREATE_NO_WINDOW if sys.platform=="win32" else 0)
            if proc.returncode == 0:
                data = json.loads(proc.stdout)
                self._duration = float(data.get("format",{}).get("duration",0))
        except Exception: pass

    def set_position(self, sec): self._position = max(0, min(sec, self._duration))
    def get_position(self) -> float: return self._position
    def get_duration(self) -> float: return self._duration

    # ===== 播放 =====
    def _toggle_play(self):
        if not self._filepath: return
        if self._playing:
            self._playing = False; self._refresh_timer.stop(); self._play_btn.setText("▶")
            if self._audio_player: self._audio_player.pause()
        else:
            if self._position >= self._duration - 0.1: self._position = 0
            self._playing = True; self._refresh_timer.start(); self._play_btn.setText("⏸")
            if self._audio_player:
                self._audio_player.setPosition(int(self._position * 1000))
                self._audio_player.play()

    def _refresh_frame(self):
        if not self._playing or not self._filepath: return
        self._position += 1.0 / max(self._fps, 1)
        if self._position >= self._duration:
            self._position = 0; self._playing = False; self._refresh_timer.stop()
            self._play_btn.setText("▶")
            if self._audio_player: self._audio_player.pause()

        if self._mode == "opencv":
            self._show_opencv_frame(self._position)
        elif self._mode == "qtmedia":
            self._show_ffmpeg_frame(self._position)
        self._update_time()

    def _show_opencv_frame(self, sec: float):
        if not self._cap or not HAS_CV2: return
        self._cap.set(cv2.CAP_PROP_POS_FRAMES, int(sec * self._fps))
        ret, frame = self._cap.read()
        if not ret: return
        self._display_frame(frame)

    def _show_ffmpeg_frame(self, sec: float):
        """FFmpeg pipe 单帧提取 (QMediaPlayer fallback)"""
        if not self._filepath: return
        dw = max(self._frame_label.width(), 320)
        dh = max(self._frame_label.height(), 180)
        cmd = [FFMPEG_PATH,"-y","-ss",str(sec),"-i",self._filepath,
               "-vframes","1","-f","rawvideo","-pix_fmt","rgb24",
               "-vf",f"scale={dw}:{dh}:force_original_aspect_ratio=decrease,pad={dw}:{dh}:(ow-iw)/2:(oh-ih)/2","-"]
        try:
            proc = subprocess.run(cmd, capture_output=True, timeout=8,
                creationflags=subprocess.CREATE_NO_WINDOW if sys.platform=="win32" else 0)
            if proc.returncode == 0 and proc.stdout:
                img = QImage(proc.stdout[:dw*dh*3], dw, dh, dw*3, QImage.Format.Format_RGB888)
                if not img.isNull(): self._frame_label.setPixmap(QPixmap.fromImage(img))
        except Exception: pass

    def _display_frame(self, frame_bgr):
        """BGR numpy array -> QLabel"""
        dw = max(self._frame_label.width(), 320)
        dh = max(self._frame_label.height(), 180)
        h, w = frame_bgr.shape[:2]
        scale = min(dw/w, dh/h); nw, nh = int(w*scale), int(h*scale)
        if nw <= 0 or nh <= 0: return
        resized = cv2.resize(frame_bgr, (nw, nh))
        rgb = cv2.cvtColor(resized, cv2.COLOR_BGR2RGB)
        img = QImage(rgb.data, nw, nh, nw*3, QImage.Format.Format_RGB888)
        if not img.isNull(): self._frame_label.setPixmap(QPixmap.fromImage(img).copy())

    # ===== Seek =====
    def _seek_press(self): self._seeking = True
    def _seek_release(self):
        self._seeking = False
        self._position = self._seek.value() / 10000.0 * self._duration
        if self._mode == "opencv": self._show_opencv_frame(self._position)
        else: self._show_ffmpeg_frame(self._position)
        if self._audio_player: self._audio_player.setPosition(int(self._position * 1000))
        self._update_time()

    def _seek_move(self, val):
        t = val / 10000.0 * self._duration
        self._time_label.setText(f"{format_duration(t)} / {format_duration(self._duration)}")

    def _update_time(self):
        self._time_label.setText(f"{format_duration(self._position)} / {format_duration(self._duration)}")
        if not self._seeking and self._duration > 0:
            self._seek.blockSignals(True)
            self._seek.setValue(int(self._position / self._duration * 10000))
            self._seek.blockSignals(False)

    def _release(self):
        self._refresh_timer.stop()
        if self._cap: self._cap.release(); self._cap = None
        if self._audio_player: self._audio_player.stop(); self._audio_player = None

    def resizeEvent(self, event):
        super().resizeEvent(event)
        if self._filepath and not self._playing:
            if self._mode == "opencv": self._show_opencv_frame(self._position)
            else: self._show_ffmpeg_frame(self._position)
