"""
VideoPreview — 专业视频播放器
OpenCV 解码画面 + QMediaPlayer 播放音频，全格式兼容
支持播放/暂停/快进/seek
【开发状态：已完成】
"""

import os
from PyQt6.QtWidgets import (
    QWidget, QVBoxLayout, QHBoxLayout, QLabel,
    QPushButton, QSlider,
)
from PyQt6.QtCore import Qt, QUrl, QTimer, pyqtSignal
from PyQt6.QtGui import QImage, QPixmap
from PyQt6.QtMultimedia import QMediaPlayer, QAudioOutput

from app.theme import COLORS
from app.utils.file_utils import format_duration


class VideoPreview(QWidget):
    """OpenCV 帧解码 + QMediaPlayer 音频 — 全格式兼容"""

    duration_loaded = pyqtSignal(float)

    def __init__(self, parent=None):
        super().__init__(parent)
        self._filepath = ""
        self._duration = 0.0
        self._fps = 30.0
        self._width = 640
        self._height = 360
        self._position = 0.0
        self._playing = False
        self._seeking = False
        self._cap = None
        self._audio_player = None
        self._audio = None
        self._init_ui()
        self._init_timer()

    def _init_ui(self):
        layout = QVBoxLayout(self)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.setSpacing(6)

        self._frame_label = QLabel("📺 请加载视频")
        self._frame_label.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self._frame_label.setMinimumHeight(300)
        self._frame_label.setStyleSheet(f"""
            QLabel {{
                background-color: #000;
                border: 1px solid {COLORS['border']};
                border-radius: 8px;
                color: {COLORS['text_muted']};
                font-size: 16px;
            }}
        """)
        layout.addWidget(self._frame_label, 1)

        ctrl = QHBoxLayout(); ctrl.setSpacing(10)

        self._play_btn = QPushButton("▶")
        self._play_btn.setFixedSize(40, 40)
        self._play_btn.setCursor(Qt.CursorShape.PointingHandCursor)
        self._play_btn.clicked.connect(self._toggle_play)
        self._play_btn.setStyleSheet(f"""
            QPushButton {{ background-color: {COLORS['accent']}; color: #fff;
            border-radius: 20px; font-size: 18px; font-weight: bold; }}
            QPushButton:hover {{ background-color: {COLORS['accent_hover']}; }}
        """)
        ctrl.addWidget(self._play_btn)

        self._time_label = QLabel("00:00 / 00:00")
        self._time_label.setStyleSheet(
            f"color: {COLORS['text_secondary']}; font-size: 13px; font-weight: 500; min-width: 120px;")
        ctrl.addWidget(self._time_label)

        self._seek = QSlider(Qt.Orientation.Horizontal)
        self._seek.setRange(0, 10000)
        self._seek.sliderPressed.connect(self._seek_press)
        self._seek.sliderReleased.connect(self._seek_release)
        self._seek.sliderMoved.connect(self._seek_move)
        ctrl.addWidget(self._seek, 1)

        layout.addLayout(ctrl)

    def _init_timer(self):
        self._refresh_timer = QTimer(self)
        self._refresh_timer.setInterval(16)  # ~60fps refresh
        self._refresh_timer.timeout.connect(self._refresh_frame)

    # ===== 公开方法 =====
    def load_video(self, filepath: str):
        self._filepath = filepath
        self._playing = False
        self._refresh_timer.stop()

        # 释放旧的
        self._release()

        if not os.path.exists(filepath):
            return

        # 用 OpenCV 打开视频
        import cv2
        self._cap = cv2.VideoCapture(filepath)
        if not self._cap.isOpened():
            self._frame_label.setText("❌ 无法打开视频文件")
            return

        self._fps = self._cap.get(cv2.CAP_PROP_FPS)
        if self._fps <= 0 or self._fps > 120:
            self._fps = 30.0
        total_frames = self._cap.get(cv2.CAP_PROP_FRAME_COUNT)
        self._duration = total_frames / self._fps if self._fps > 0 else 0
        self._width = int(self._cap.get(cv2.CAP_PROP_FRAME_WIDTH))
        self._height = int(self._cap.get(cv2.CAP_PROP_FRAME_HEIGHT))
        self._position = 0.0

        # QMediaPlayer 仅播音频
        try:
            from PyQt6.QtCore import QUrl
            self._audio_player = QMediaPlayer()
            self._audio = QAudioOutput()
            self._audio_player.setAudioOutput(self._audio)
            self._audio_player.setSource(QUrl.fromLocalFile(os.path.abspath(filepath)))
        except Exception:
            self._audio_player = None

        self._seek.setValue(0)
        self._update_time()
        self._show_frame_at(0)
        self.duration_loaded.emit(self._duration)

    def set_position(self, sec: float):
        self._position = max(0, min(sec, self._duration))
        self._show_frame_at(self._position)
        self._update_time()

    def get_position(self) -> float:
        return self._position

    def get_duration(self) -> float:
        return self._duration

    # ===== 播放控制 =====
    def _toggle_play(self):
        if not self._cap:
            return
        if self._playing:
            self._playing = False
            self._refresh_timer.stop()
            self._play_btn.setText("▶")
            if self._audio_player:
                self._audio_player.pause()
        else:
            if self._position >= self._duration - 0.1:
                self._position = 0
            self._playing = True
            self._refresh_timer.start()
            self._play_btn.setText("⏸")
            if self._audio_player:
                self._audio_player.setPosition(int(self._position * 1000))
                self._audio_player.play()

    def _refresh_frame(self):
        if not self._playing or not self._cap:
            return
        # 计算应该显示的帧位置
        elapsed = 1.0 / self._fps
        self._position += elapsed
        if self._position >= self._duration:
            self._position = 0
            self._playing = False
            self._refresh_timer.stop()
            self._play_btn.setText("▶")
            if self._audio_player:
                self._audio_player.pause()

        self._show_frame_at(self._position)
        self._update_time()

    def _show_frame_at(self, sec: float):
        if not self._cap:
            return
        import cv2
        # 跳转到目标帧
        frame_idx = int(sec * self._fps)
        self._cap.set(cv2.CAP_PROP_POS_FRAMES, frame_idx)
        ret, frame = self._cap.read()
        if not ret:
            return

        # BGR → RGB
        frame_rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
        h, w, ch = frame_rgb.shape

        # 缩放到显示区域
        display_w = max(self._frame_label.width(), 320)
        display_h = max(self._frame_label.height(), 180)
        scale = min(display_w / w, display_h / h)
        new_w, new_h = int(w * scale), int(h * scale)

        if new_w > 0 and new_h > 0:
            resized = cv2.resize(frame_rgb, (new_w, new_h))
            img = QImage(resized.data, new_w, new_h, new_w * 3, QImage.Format.Format_RGB888)
            if not img.isNull():
                self._frame_label.setPixmap(QPixmap.fromImage(img).copy())

    # ===== Seek =====
    def _seek_press(self):
        self._seeking = True

    def _seek_release(self):
        self._seeking = False
        val = self._seek.value()
        self._position = val / 10000.0 * self._duration
        self._show_frame_at(self._position)
        if self._audio_player:
            self._audio_player.setPosition(int(self._position * 1000))
        self._update_time()

    def _seek_move(self, val: int):
        t = val / 10000.0 * self._duration
        self._time_label.setText(f"{format_duration(t)} / {format_duration(self._duration)}")

    def _update_time(self):
        self._time_label.setText(f"{format_duration(self._position)} / {format_duration(self._duration)}")
        if not self._seeking and self._duration > 0:
            val = int(self._position / self._duration * 10000)
            self._seek.blockSignals(True)
            self._seek.setValue(val)
            self._seek.blockSignals(False)

    # ===== 清理 =====
    def _release(self):
        self._refresh_timer.stop()
        if self._cap:
            self._cap.release()
            self._cap = None
        if self._audio_player:
            self._audio_player.stop()
            self._audio_player = None

    def resizeEvent(self, event):
        super().resizeEvent(event)
        if self._cap and not self._playing:
            self._show_frame_at(self._position)
