"""
FormatSelector — 视频画质/格式选择控件
【开发状态：已完成】
"""

from PyQt6.QtWidgets import (
    QWidget, QVBoxLayout, QHBoxLayout, QLabel,
    QComboBox, QPushButton, QScrollArea, QGridLayout,
)
from PyQt6.QtCore import Qt, pyqtSignal
from app.theme import COLORS
from app.utils.file_utils import format_filesize


class FormatCard(QWidget):
    """单个格式选项卡片"""
    selected = pyqtSignal(dict)

    def __init__(self, fmt: dict, parent=None):
        super().__init__(parent)
        self.fmt = fmt
        self._init_ui()

    def _init_ui(self):
        self.setFixedHeight(72)
        self.setCursor(Qt.CursorShape.PointingHandCursor)
        self.setStyleSheet(f"""
            FormatCard {{
                background-color: {COLORS['bg_card']};
                border: 1px solid {COLORS['border']};
                border-radius: 8px;
                padding: 8px 12px;
            }}
            FormatCard:hover {{
                border-color: {COLORS['accent']};
                background-color: {COLORS['accent_light']};
            }}
        """)

        layout = QVBoxLayout(self)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.setSpacing(4)

        # 第一行：分辨率 + 格式
        row1 = QHBoxLayout()
        res = self.fmt.get("resolution", "?")
        ext = self.fmt.get("ext", "mp4").upper()
        label = QLabel(f"{res}  {ext}")
        label.setStyleSheet(f"font-weight: 600; font-size: 14px; color: {COLORS['text_primary']}; background:transparent;")
        row1.addWidget(label)
        row1.addStretch()

        # 编解码信息
        vcodec = self.fmt.get("vcodec", "")
        acodec = self.fmt.get("acodec", "")
        codec_text = f"{vcodec}" if vcodec else ""
        if acodec and acodec != "none":
            codec_text += f" / {acodec}"
        if codec_text:
            codec_lbl = QLabel(codec_text)
            codec_lbl.setStyleSheet(f"font-size: 11px; color: {COLORS['text_muted']}; background:transparent;")
            row1.addWidget(codec_lbl)

        layout.addLayout(row1)

        # 第二行：文件大小
        row2 = QHBoxLayout()
        size = format_filesize(self.fmt.get("filesize") or self.fmt.get("filesize_approx"))
        has_audio = "🔊" if self.fmt.get("has_audio") else "🔇"
        info_label = QLabel(f"{has_audio}  {size}")
        info_label.setStyleSheet(f"font-size: 12px; color: {COLORS['text_secondary']}; background:transparent;")
        row2.addWidget(info_label)
        row2.addStretch()

        layout.addLayout(row2)

    def mousePressEvent(self, event):
        self.selected.emit(self.fmt)
        super().mousePressEvent(event)


class FormatSelector(QWidget):
    """格式列表容器"""
    format_selected = pyqtSignal(dict)

    def __init__(self, parent=None):
        super().__init__(parent)
        self._formats: list[dict] = []
        self._init_ui()

    def _init_ui(self):
        layout = QVBoxLayout(self)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.setSpacing(8)

        title = QLabel("可选画质")
        title.setStyleSheet(f"font-weight: 600; font-size: 14px; color: {COLORS['text_primary']};")
        layout.addWidget(title)

        self._scroll = QScrollArea()
        self._scroll.setWidgetResizable(True)
        self._scroll.setStyleSheet(f"QScrollArea {{ border: none; background: transparent; }}")

        self._container = QWidget()
        self._grid = QGridLayout(self._container)
        self._grid.setContentsMargins(0, 0, 0, 0)
        self._grid.setSpacing(8)
        self._scroll.setWidget(self._container)

        layout.addWidget(self._scroll)

    def set_formats(self, formats: list[dict]):
        """设置并展示格式列表"""
        # 清除旧控件
        while self._grid.count():
            item = self._grid.takeAt(0)
            if item.widget():
                item.widget().deleteLater()

        self._formats = formats
        cols = 2
        for i, fmt in enumerate(formats):
            card = FormatCard(fmt)
            card.selected.connect(self._on_select)
            self._grid.addWidget(card, i // cols, i % cols)

    def _on_select(self, fmt: dict):
        self.format_selected.emit(fmt)

    def get_format_id(self, fmt: dict) -> str:
        """从格式 dict 获取 format_id"""
        return fmt.get("format_id", "")
