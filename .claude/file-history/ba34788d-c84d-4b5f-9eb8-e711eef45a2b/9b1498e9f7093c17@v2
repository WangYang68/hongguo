class AudioStutterEffect(BaseEffect):
    """音频卡壳"""
    name = "音频卡壳"
    category = "音频魔改"
    description = "某段声音重复播放"
    status = "已完成"
    @classmethod
    def get_param_defs(cls):
        return [EffectParam("repeat", "重复次数", int, 4, 2, 10, 1)]
    def get_filter_string(self, in_label="0:v", out_label="v0"): return ""
    def get_audio_filter_string(self, in_label="0:a", out_label="a0"):
        r = self.get_param("repeat") or 4
        return f"[{in_label}]aloop={r - 1}:1000[{out_label}]"


class PanEffect(BaseEffect):
    """声道摇摆"""
    name = "声道摇摆"
    category = "音频魔改"
    description = "声音左右快速来回摇摆"
    status = "已完成"
    @classmethod
    def get_param_defs(cls):
        return [EffectParam("speed", "摇摆速度", float, 2.0, 0.5, 10.0, 0.5, suffix="Hz")]
    def get_filter_string(self, in_label="0:v", out_label="v0"): return ""
    def get_audio_filter_string(self, in_label="0:a", out_label="a0"):
        s = self.get_param("speed") or 2.0
        return f"[{in_label}]stereotools=mlev=0.01*sin(2*PI*{s}*t):slev=0.01*cos(2*PI*{s}*t)[{out_label}]"
