"""
VideoPreview — 视频预览控件
QLabel 显示帧 + 播放/暂停 + seek 滑块
【开发状态：已完成】
"""

import os
from PyQt6.QtWidgets import (
    QWidget, QVBoxLayout, QHBoxLayout, QLabel,
    QPushButton, QSlider, QGroupBox,
)
from PyQt6.QtCore import Qt, QTimer
from PyQt6.QtGui import QPixmap

from app.theme import COLORS
from app.ffmpeg.frame_extractor import FrameExtractor
from app.ffmpeg.probe import FFprobeReader
from app.utils.file_utils import format_duration


class VideoPreview(QWidget):
    """视频预览区"""

    def __init__(self, parent=None):
        super().__init__(parent)
        self._filepath = ""
        self._duration = 0.0
        self._position = 0.0
        self._playing = False
        self._timer = QTimer(self)
        self._timer.timeout.connect(self._tick)
        self._fps = 30.0
        self._init_ui()

    def _init_ui(self):
        layout = QVBoxLayout(self)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.setSpacing(8)

        # 画面
        self._frame_label = QLabel("请加载视频")
        self._frame_label.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self._frame_label.setMinimumHeight(300)
        self._frame_label.setStyleSheet(f"""
            QLabel {{
                background-color: #000;
                border: 1px solid {COLORS['border']};
                border-radius: 8px;
                color: {COLORS['text_muted']};
                font-size: 16px;
            }}
        """)
        layout.addWidget(self._frame_label, 1)

        # 控制栏
        ctrl = QHBoxLayout()
        ctrl.setSpacing(8)

        self._play_btn = QPushButton("▶")
        self._play_btn.setFixedWidth(40)
        self._play_btn.setCursor(Qt.CursorShape.PointingHandCursor)
        self._play_btn.clicked.connect(self._toggle_play)
        ctrl.addWidget(self._play_btn)

        self._time_label = QLabel("00:00 / 00:00")
        self._time_label.setStyleSheet(f"color: {COLORS['text_secondary']}; font-size: 12px;")
        ctrl.addWidget(self._time_label)

        self._seek = QSlider(Qt.Orientation.Horizontal)
        self._seek.setRange(0, 1000)
        self._seek.sliderMoved.connect(self._seek_to)
        ctrl.addWidget(self._seek, 1)

        layout.addLayout(ctrl)

    # ---- 公开方法 ----
    def load_video(self, filepath: str):
        """加载视频文件"""
        self._filepath = filepath
        if not os.path.exists(filepath):
            return

        probe = FFprobeReader(filepath)
        info = probe.get_video_info()
        self._duration = info.get("duration", 0)
        self._fps = info.get("fps", 30)

        self._position = 0
        self._show_frame(0)
        self._update_time()
        self._play_btn.setText("▶")
        self._playing = False

    def set_position(self, sec: float):
        """跳转到指定位置"""
        self._position = max(0, min(sec, self._duration))
        self._show_frame(self._position)
        self._update_time()

    # ---- 内部 ----
    def _show_frame(self, time_sec: float):
        if not self._filepath:
            return
        extractor = FrameExtractor(self._filepath)
        pix = extractor.get_thumbnail(max_width=640, time_sec=time_sec)
        if pix:
            scaled = pix.scaled(
                self._frame_label.width(), self._frame_label.height(),
                Qt.AspectRatioMode.KeepAspectRatio,
                Qt.TransformationMode.SmoothTransformation,
            )
            self._frame_label.setPixmap(scaled)

    def _toggle_play(self):
        if not self._filepath:
            return
        self._playing = not self._playing
        self._play_btn.setText("⏸" if self._playing else "▶")
        if self._playing:
            self._timer.start(int(1000 / self._fps))
        else:
            self._timer.stop()

    def _tick(self):
        self._position += 1.0 / self._fps
        if self._position >= self._duration:
            self._position = 0
            self._playing = False
            self._timer.stop()
            self._play_btn.setText("▶")
        self._show_frame(self._position)
        self._update_time()

    def _seek_to(self, val: int):
        self._position = val / 1000.0 * self._duration
        self._show_frame(self._position)
        self._update_time()

    def _update_time(self):
        self._time_label.setText(
            f"{format_duration(self._position)} / {format_duration(self._duration)}"
        )
        self._seek.blockSignals(True)
        self._seek.setValue(int(self._position / max(self._duration, 0.01) * 1000))
        self._seek.blockSignals(False)

    def resizeEvent(self, event):
        super().resizeEvent(event)
        if self._filepath:
            self._show_frame(self._position)
