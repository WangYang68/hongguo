class HelpDialog(QDialog):
    """使用帮助弹窗"""

    def __init__(self, parent=None):
        super().__init__(parent)
        self.setWindowTitle("MagicVideo 使用帮助")
        self.resize(760, 620)
        self.setStyleSheet(f"""
            QDialog {{ background-color: {COLORS['bg_secondary']}; }}
            QTabWidget::pane {{ border: 1px solid {COLORS['border']}; border-radius: 6px; }}
        """)
        layout = QVBoxLayout(self)

        tabs = QTabWidget()
        tabs.addTab(self._html_page(HELP_HTML), "📖 使用指南")
        tabs.addTab(self._html_page(EFFECT_HELP), "✦ 特效说明")
        layout.addWidget(tabs)

        close_btn = QPushButton("关闭")
        close_btn.clicked.connect(self.accept)
        close_btn.setStyleSheet(f"""
            QPushButton {{ background:{COLORS['accent']}; color:#fff; border-radius:6px;
            padding:10px 32px; font-size:14px; }}
        """)
        layout.addWidget(close_btn, alignment=Qt.AlignmentFlag.AlignRight)

    def _html_page(self, html: str) -> QWidget:
        w = QWidget()
        lay = QVBoxLayout(w)
        edit = QTextEdit()
        edit.setReadOnly(True)
        edit.setHtml(html.replace("<table", "<table border='1' cellpadding='4' cellspacing='0'"))
        edit.setStyleSheet(f"""
            QTextEdit {{ background:{COLORS['bg_primary']}; color:{COLORS['text_primary']};
            border: none; font-size: 13px; }}
        """)
        lay.addWidget(edit)
        return w
