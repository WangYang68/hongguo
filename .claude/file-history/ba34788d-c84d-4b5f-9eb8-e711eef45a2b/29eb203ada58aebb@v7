    # ===== 视频加载 =====
    def _open_file(self):
        path, _ = QFileDialog.getOpenFileName(self, "选择视频", "", "视频 (*.mp4 *.mov *.avi *.mkv *.webm *.flv *.wmv);;全部 (*.*)")
        if path: self.load_source(path)

    def load_source(self, path: str):
        self._source = path; self._preview.load_video(path)
        probe = FFprobeReader(path); info = probe.get_video_info()
        dur = info.get("duration", 0)
        self._info_lbl.setText(f"{info.get('width',0)}x{info.get('height',0)} | {format_duration(dur)} | {format_filesize(info.get('size_bytes',0))}")
        self._info_text.setText(
            f"路径: {path}\n分辨率: {info.get('width',0)}x{info.get('height',0)}\n"
            f"时长: {format_duration(dur)}\n帧率: {info.get('fps',0):.1f} fps\n"
            f"视频编码: {info.get('vcodec','?')}\n音频编码: {info.get('acodec','?')}\n"
            f"大小: {format_filesize(info.get('size_bytes',0))}\n格式: {info.get('format','?')}"
        )
        self._t_end.setValue(dur)
        self._concat.add_file(path)
        self._concat_list.addItem(os.path.basename(path))
        self.source_changed.emit(path)

    # ===== 格式转换 =====
    def _convert(self):
        if not self._source: return
        fmt = self._fmt_combo.currentText()
        base = sanitize_filename(os.path.splitext(os.path.basename(self._source))[0])
        out = os.path.join(str(OUTPUT_DIR), f"{base}_converted.{fmt}")
        if fmt in ("mp3","wav"):
            cmd = [FFMPEG_PATH, "-y", "-i", self._source, "-vn", "-c:a", "libmp3lame" if fmt=="mp3" else "pcm_s16le", out]
        elif fmt == "gif":
            cmd = [FFMPEG_PATH, "-y", "-i", self._source, "-vf", "fps=10,scale=480:-1", "-loop", "0", out]
        else:
            cmd = [FFMPEG_PATH, "-y", "-i", self._source, "-c:v", "libx264", "-c:a", "aac", out]
        self._run_ffmpeg(cmd, f"转换完成:\n{out}")

    # ===== 音频 =====
    def _extract_audio(self):
        if not self._source: return
        out = os.path.join(str(OUTPUT_DIR), f"{sanitize_filename(os.path.splitext(os.path.basename(self._source))[0])}_audio.mp3")
        self._run_ffmpeg([FFMPEG_PATH,"-y","-i", self._source, "-vn","-c:a","libmp3lame","-q:a","2", out], f"音频提取完成:\n{out}")

    def _mute_video(self):
        if not self._source: return
        out = os.path.join(str(OUTPUT_DIR), f"{sanitize_filename(os.path.splitext(os.path.basename(self._source))[0])}_muted.mp4")
        self._run_ffmpeg([FFMPEG_PATH,"-y","-i", self._source, "-c:v","copy","-an", out], f"静音视频完成:\n{out}")

    def _pick_bgm(self):
        path, _ = QFileDialog.getOpenFileName(self, "选择音频", "", "音频 (*.mp3 *.wav *.aac *.flac *.ogg);;全部 (*.*)")
        if path: self._bgm_path.setText(path)

    def _replace_bgm(self):
        if not self._source or not self._bgm_path.text(): return
        out = os.path.join(str(OUTPUT_DIR), f"{sanitize_filename(os.path.splitext(os.path.basename(self._source))[0])}_newbgm.mp4")
        vol = self._vol_ratio.value()
        cmd = [FFMPEG_PATH,"-y","-i", self._source,"-i", self._bgm_path.text(),
               "-c:v","copy","-map","0:v:0","-map","1:a:0","-c:a","aac","-b:a","128k","-shortest"]
        if vol != 1.0: cmd.extend(["-af", f"volume={vol}"])
        cmd.append(out)
        self._run_ffmpeg(cmd, f"BGM替换完成:\n{out}")

    def _adjust_volume(self):
        if not self._source: return
        vol = self._vol_ratio.value()
        out = os.path.join(str(OUTPUT_DIR), f"{sanitize_filename(os.path.splitext(os.path.basename(self._source))[0])}_vol{vol:.1f}.mp4")
        self._run_ffmpeg([FFMPEG_PATH,"-y","-i", self._source, "-c:v","copy", "-af",f"volume={vol}", out], f"音量调整完成:\n{out}")

    # ===== 字幕 =====
    def _pick_sub(self):
        path, _ = QFileDialog.getOpenFileName(self, "选择字幕", "", "字幕 (*.srt *.ass *.vtt);;全部 (*.*)")
        if path: self._sub_path.setText(path)

    def _burn_sub(self):
        if not self._source or not self._sub_path.text(): return
        sub = os.path.abspath(self._sub_path.text()).replace("\\","/").replace(":","\\\\:")
        out = os.path.join(str(OUTPUT_DIR), f"{sanitize_filename(os.path.splitext(os.path.basename(self._source))[0])}_subbed.mp4")
        ext = os.path.splitext(self._sub_path.text())[1].lower()
        vf = f"ass={sub}" if ext == ".ass" else f"subtitles={sub}"
        self._run_ffmpeg([FFMPEG_PATH,"-y","-i", self._source, "-vf", vf, "-c:a","copy", out], f"字幕烧录完成:\n{out}")

    # ===== 帧 =====
    def _capture_frame(self):
        if not self._source: return
        pos = self._preview.get_position()
        out = os.path.join(str(OUTPUT_DIR), f"{sanitize_filename(os.path.splitext(os.path.basename(self._source))[0])}_frame_{pos:.1f}s.png")
        self._run_ffmpeg([FFMPEG_PATH,"-y","-ss", str(pos), "-i", self._source, "-vframes","1", out], f"帧截图已保存:\n{out}")

    def _make_gif(self):
        if not self._source: return
        start = self._t_start.value(); dur = max(1, self._t_end.value() - start) if self._t_end.value() > start else 3
        out = os.path.join(str(OUTPUT_DIR), f"{sanitize_filename(os.path.splitext(os.path.basename(self._source))[0])}.gif")
        self._run_ffmpeg([FFMPEG_PATH,"-y","-ss", str(start), "-t", str(dur), "-i", self._source,
                          "-vf","fps=10,scale=480:-1:flags=lanczos", out], f"GIF已生成:\n{out}")

    # ===== 拼接 =====
    def _add_concat(self):
        p, _ = QFileDialog.getOpenFileName(self, "选择视频", "", "视频 (*.mp4 *.mov *.avi *.mkv *.webm)")
        if p: self._concat.add_file(p); self._concat_list.addItem(os.path.basename(p))

    def _remove_concat(self):
        r = self._concat_list.currentRow()
        if r >= 0: self._concat_list.takeItem(r); self._concat.remove_file(r)

    def _do_concat(self):
        if len(self._concat) < 2: return
        # 写 concat 文件列表
        import tempfile
        with tempfile.NamedTemporaryFile(mode="w", suffix=".txt", delete=False, encoding="utf-8") as f:
            for fp in self._concat.files:
                f.write(f"file '{os.path.abspath(fp).replace(chr(92), '/')}'\n")
            list_path = f.name
        out = os.path.join(str(OUTPUT_DIR), f"{sanitize_filename(os.path.splitext(os.path.basename(self._source))[0])}_merged.mp4")
        self._run_ffmpeg([FFMPEG_PATH,"-y","-f","concat","-safe","0","-i", list_path, "-c","copy", out],
                         f"拼接完成:\n{out}", cleanup=list_path)

    # ===== 特效 =====
    def _populate_fx_tree(self):
        from app.effects import time, spatial, color, blur_noise, overlay, keying, audio, combo  # noqa
        for cat, names in sorted(EffectRegistry.all_categories().items()):
            ci = QTreeWidgetItem([cat])
            for n in sorted(names): ch = QTreeWidgetItem([n]); ch.setData(0, Qt.ItemDataRole.UserRole, n); ci.addChild(ch)
            self._fx_tree.addTopLevelItem(ci)
        self._fx_tree.expandAll()

    def _add_fx(self, item, col):
        n = item.data(0, Qt.ItemDataRole.UserRole)
        if not n: return
        e = EffectRegistry.instantiate(n)
        if e: self._pipeline.add(e); self._refresh_fx()

    def _remove_fx(self):
        r = self._fx_list.currentRow()
        if r >= 0: self._pipeline.remove(r); self._refresh_fx()

    def _refresh_fx(self):
        self._fx_list.clear()
        for e in self._pipeline:
            i = QListWidgetItem(f"{'✅' if e.enabled else '❌'} {e.name}")
            i.setData(Qt.ItemDataRole.UserRole, self._pipeline._effects.index(e)); self._fx_list.addItem(i)

    def _on_fx_select(self, item):
        idx = item.data(Qt.ItemDataRole.UserRole)
        if idx is None or idx >= len(self._pipeline): return
        self._show_fx_params(idx)

    def _show_fx_params(self, idx):
        while self._fx_params_l.count():
            c = self._fx_params_l.takeAt(0)
            if c.widget(): c.widget().deleteLater()
        eff = self._pipeline[idx]
        cb = QCheckBox("启用"); cb.setChecked(eff.enabled)
        cb.toggled.connect(lambda v: (setattr(eff,'enabled',v), self._refresh_fx())); self._fx_params_l.addWidget(cb)
        for p in eff.get_param_defs():
            self._fx_params_l.addWidget(QLabel(p.label))
            if isinstance(p.options, list) and len(p.options) > 0:
                w = QComboBox()
                for v, lb in p.options: w.addItem(str(lb), v)
                default_val = eff.get_param(p.name)
                match_idx = 0
                for i_opt, (v_opt, _) in enumerate(p.options):
                    if v_opt == default_val: match_idx = i_opt; break
                w.setCurrentIndex(match_idx)
                w.currentIndexChanged.connect(lambda i, n=p.name, o=p.options: eff.set_param(n, o[i][0])); self._fx_params_l.addWidget(w)
            elif p.param_type is float:
                w = QDoubleSpinBox(); w.setRange(p.min_val or 0, p.max_val or 100)
                if p.step: w.setSingleStep(p.step)
                w.setValue(eff.get_param(p.name) or 0)
                if p.suffix: w.setSuffix(f" {p.suffix}")
                w.valueChanged.connect(lambda v, n=p.name: eff.set_param(n, v)); self._fx_params_l.addWidget(w)
            elif p.param_type is int:
                w = QSpinBox(); w.setRange(int(p.min_val or 0), int(p.max_val or 100))
                w.setValue(eff.get_param(p.name) or 0)
                if p.suffix: w.setSuffix(f" {p.suffix}")
                w.valueChanged.connect(lambda v, n=p.name: eff.set_param(n, v)); self._fx_params_l.addWidget(w)

    # ===== 通用 FFmpeg 运行 =====
    def _run_ffmpeg(self, cmd: list, success_msg: str, cleanup: str = None):
        """后台异步运行 FFmpeg，通过状态栏反馈进度"""
        self.status_message.emit("⏳ FFmpeg 处理中...")
        self.progress_update.emit(0)

        class _Worker(QThread):
            done = pyqtSignal(bool, str)
            def run(self):
                try:
                    proc = subprocess.run(cmd, capture_output=True, encoding="utf-8", errors="replace", timeout=300,
                        creationflags=subprocess.CREATE_NO_WINDOW if sys.platform=="win32" else 0)
                    self.done.emit(proc.returncode == 0, proc.stderr[-300:] if proc.returncode != 0 else "")
                except Exception as e:
                    self.done.emit(False, str(e))
        worker = _Worker()
        self._workers.append(worker)

        def on_done(ok, err):
            if ok:
                self.status_message.emit(f"✅ {success_msg}")
                self.progress_update.emit(100)
                QMessageBox.information(self, "完成", success_msg)
            else:
                self.status_message.emit(f"❌ 处理失败: {err[:100]}")
                QMessageBox.warning(self, "失败", f"FFmpeg 错误:\n{err}")
            if cleanup and os.path.exists(cleanup):
                os.unlink(cleanup)
            self._workers = [w for w in self._workers if w is not worker]

        worker.done.connect(on_done)
        worker.finished.connect(worker.deleteLater)
        worker.start()

    # ===== 公开 =====
    def _preview_effects(self):
        """渲染当前帧 + 特效 pipeline，弹窗展示"""
        if not self._source or len(self._pipeline) == 0:
            QMessageBox.information(self, "提示", "请先加载视频并添加特效")
            return
        vid_graph, vid_label = self._pipeline.build_video_filter_graph()
        if not vid_graph.strip():
            QMessageBox.information(self, "提示", "没有启用的特效可预览")
            return

        pos = self._preview.get_position()
        out_img = os.path.join(str(OUTPUT_DIR), "_preview_frame.png")

        cmd = [FFMPEG_PATH, "-y", "-ss", str(pos), "-i", self._source,
               "-vframes", "1", "-filter_complex", vid_graph,
               "-map", vid_label if vid_label != "0:v" else "0:v",
               "-f", "image2", out_img]

        self.status_message.emit("⏳ 正在渲染特效预览...")
        def _do():
            proc = subprocess.run(cmd, capture_output=True, encoding="utf-8", errors="replace", timeout=30,
                creationflags=subprocess.CREATE_NO_WINDOW if sys.platform=="win32" else 0)
            ok = proc.returncode == 0 and os.path.exists(out_img) and os.path.getsize(out_img) > 0
            if ok:
                self.status_message.emit(f"✅ 特效预览完成 — {out_img}")
                # 弹窗显示
                pix = QPixmap(out_img)
                if not pix.isNull():
                    dlg = QDialog(self); dlg.setWindowTitle("特效预览"); dlg.resize(800, 500)
                    dl = QVBoxLayout(dlg)
                    lbl = QLabel(); lbl.setPixmap(pix.scaled(780, 460, Qt.AspectRatioMode.KeepAspectRatio, Qt.TransformationMode.SmoothTransformation))
                    dl.addWidget(lbl)
                    dlg.exec()
                else:
                    QMessageBox.warning(self, "预览失败", "特效渲染失败，请检查参数")
            else:
                self.status_message.emit("❌ 特效预览失败")
                QMessageBox.warning(self, "错误", f"FFmpeg 错误:\n{proc.stderr[-300:]}")
            try: os.unlink(out_img)
            except: pass

        t = QThread()
        t.run = _do
        self._workers.append(t)
        t.finished.connect(t.deleteLater)
        t.start()

    def _show_help(self):
        dlg = HelpDialog(self); dlg.exec()

    def get_source(self) -> str: return self._source
    def get_trim(self) -> TrimHandler: return self._trim
    def get_pipeline(self) -> EffectPipeline: return self._pipeline
