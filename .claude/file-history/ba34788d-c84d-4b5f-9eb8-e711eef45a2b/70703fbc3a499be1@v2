# ---------------------------------------------------------------------------
# FFmpeg 路径发现
# ---------------------------------------------------------------------------
def _find_ffmpeg() -> str:
    """查找 ffmpeg 可执行文件，找不到返回 'ffmpeg'（期望在 PATH 中）"""
    path = shutil.which("ffmpeg")
    if path:
        return path
    # 尝试 static_ffmpeg
    try:
        import static_ffmpeg
        exes = static_ffmpeg.run.get_or_fetch_platform_executables_else_raise()
        return exes[0]  # ffmpeg path
    except Exception:
        return "ffmpeg"

def _find_ffprobe() -> str:
    """查找 ffprobe 可执行文件"""
    path = shutil.which("ffprobe")
    if path:
        return path
    try:
        import static_ffmpeg
        exes = static_ffmpeg.run.get_or_fetch_platform_executables_else_raise()
        # static_ffmpeg 列表中 ffprobe 通常第二个
        for e in exes:
            if "ffprobe" in e:
                return e
        return "ffprobe"
    except Exception:
        return "ffprobe"

FFMPEG_PATH = _find_ffmpeg()
FFPROBE_PATH = _find_ffprobe()

