@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun HomeScreen(
    modifier: Modifier = Modifier,
    viewModel: MainViewModel,
    onMusicClick: (MusicEntity) -> Unit = {},
    onCalibrationClick: () -> Unit
) {
    val context = LocalContext.current
    val uiState by viewModel.uiState.collectAsState()
    val musicList by viewModel.musicList.collectAsState()
    val searchQuery by viewModel.searchQuery.collectAsState()
    val selectedTag by viewModel.selectedTag.collectAsState()

    var showPermissionDialog by remember { mutableStateOf(false) }
    var permissionDialogType by remember { mutableStateOf(PermissionType.NONE) }
    var pendingCalibrationPackage by remember { mutableStateOf<String?>(null) }
    var pendingCalibrationKeyCount by remember { mutableIntStateOf(21) }

    val tags = remember { listOf("全部", "流行", "古典", "动漫", "游戏", "钢琴", "爵士") }

    LaunchedEffect(Unit) {
        if (!viewModel.checkAccessibilityPermission()) {
            showPermissionDialog = true
            permissionDialogType = PermissionType.ACCESSIBILITY
        }
    }

    LaunchedEffect(showPermissionDialog) {
        if (!showPermissionDialog && pendingCalibrationPackage != null) {
            if (viewModel.checkOverlayPermission()) {
                FloatingCalibrationService.start(context, pendingCalibrationPackage!!, pendingCalibrationKeyCount)
                pendingCalibrationPackage = null
            }
        }
    }

    Box(
        modifier = modifier
            .fillMaxSize()
            .background(BackgroundDark)
    ) {
        Column(modifier = Modifier.fillMaxSize()) {
            // 顶部标题栏
            HomeTopBar(
                selectedAppName = uiState.selectedAppPackage?.let {
                    SupportedApps.findByPackage(it)?.appName
                } ?: "选择目标应用",
                onSettingsClick = onCalibrationClick,
                onAppSelectorClick = { viewModel.toggleAppSelector() },
                onRefreshClick = {
                    viewModel.scanLocalMidiFiles()
                }
            )

            // 搜索框
            SearchBar(
                query = searchQuery,
                onQueryChange = viewModel::searchMusic,
                modifier = Modifier.padding(horizontal = 16.dp, vertical = 8.dp)
            )

            // 标签筛选行
            TagFilterRow(
                tags = tags,
                selectedTag = selectedTag,
                onTagClick = viewModel::selectTag
            )

            // 音乐列表
            if (musicList.isEmpty()) {
                EmptyStateView()
            } else {
                val listState = rememberLazyListState()

                // 监听滚动到底部 - 自动加载更多
                LaunchedEffect(listState.layoutInfo.visibleItemsInfo.lastOrNull()?.index) {
                    val lastVisibleIndex = listState.layoutInfo.visibleItemsInfo.lastOrNull()?.index ?: 0
                    val totalItems = listState.layoutInfo.totalItemsCount
                    if (totalItems > 0 && lastVisibleIndex >= totalItems - 3) {
                        viewModel.loadMore()
                    }
                }

                LazyColumn(
                    state = listState,
                    modifier = Modifier.fillMaxSize(),
                    contentPadding = PaddingValues(horizontal = 16.dp, vertical = 8.dp),
                    verticalArrangement = Arrangement.spacedBy(10.dp)
                ) {
                    items(musicList, key = { it.id }) { music ->
                        MusicCard(
                            music = music,
                            isCurrentlyPlaying = uiState.isPlaying && uiState.currentMusicId == music.id,
                            onClick = { handleMusicClick(music, viewModel, context, pendingCalibrationPackage, pendingCalibrationKeyCount, showPermissionDialog, permissionDialogType) }
                        )
                    }
                }
            }
        }

        // 播放控制条
        AnimatedVisibility(
            visible = uiState.currentMusicId != null,
            enter = slideInVertically(initialOffsetY = { it }) + fadeIn(),
            exit = slideOutVertically(targetOffsetY = { it }) + fadeOut(),
            modifier = Modifier.align(Alignment.BottomCenter)
        ) {
            PlaybackFloatingBar(
                musicTitle = uiState.currentMusicTitle ?: "未知曲目",
                isPlaying = uiState.isPlaying,
                onPauseClick = viewModel::pausePlayback,
                onResumeClick = viewModel::resumePlayback,
                onStopClick = viewModel::stopPlayback
            )
        }

        // 应用选择器弹窗
        if (uiState.showAppSelector) {
            AppSelectorDialog(
                apps = SupportedApps.apps,
                onAppSelected = { app ->
                    viewModel.selectTargetApp(app.packageName)
                    if (viewModel.checkOverlayPermission()) {
                        android.widget.Toast.makeText(context, "请在 ${app.appName} 界面标定琴键坐标", android.widget.Toast.LENGTH_LONG).show()
                        FloatingCalibrationService.start(context, app.packageName, app.keyCount)
                    } else {
                        pendingCalibrationPackage = app.packageName
                        pendingCalibrationKeyCount = app.keyCount
                        showPermissionDialog = true
                        permissionDialogType = PermissionType.OVERLAY
                    }
                    uiState.pendingMusicId?.let { viewModel.playMusic(it) }
                },
                onDismiss = { viewModel.toggleAppSelector() }
            )
        }

        // 权限对话框
        if (showPermissionDialog) {
            PermissionDialog(
                permissionType = permissionDialogType,
                onDismiss = { showPermissionDialog = false },
                onOpenSettings = {
                    when (permissionDialogType) {
                        PermissionType.ACCESSIBILITY -> viewModel.openAccessibilitySettings()
                        PermissionType.OVERLAY -> viewModel.openOverlaySettings()
                        else -> {}
                    }
                    showPermissionDialog = false
                }
            )
        }

        // 错误提示
        uiState.errorMessage?.let { error ->
            Snackbar(
                modifier = Modifier.align(Alignment.BottomCenter).padding(16.dp),
                actionContentColor = ErrorRed,
                containerColor = SurfaceDark
            ) { Text(error, color = TextPrimary) }
            LaunchedEffect(error) {
                kotlinx.coroutines.delay(3000)
                viewModel.clearError()
            }
        }
    }
}

private fun handleMusicClick(
    music: MusicEntity,
    viewModel: MainViewModel,
    context: android.content.Context,
    pendingCalibrationPackage: String?,
    pendingCalibrationKeyCount: Int,
    showPermissionDialog: Boolean,
    permissionDialogType: PermissionType
) {
    viewModel.checkAppAndCoordinates { result ->
        when (result) {
            is AppCheckResult.OK -> viewModel.playMusic(music.id)
            AppCheckResult.NO_APP_SELECTED -> viewModel.toggleAppSelector()
            is AppCheckResult.NO_COORDINATES -> {
                if (viewModel.checkOverlayPermission()) {
                    android.widget.Toast.makeText(
                        context,
                        "请在 ${SupportedApps.findByPackage(result.packageName)?.appName ?: "目标应用"} 界面标定琴键坐标",
                        android.widget.Toast.LENGTH_LONG
                    ).show()
                    FloatingCalibrationService.start(context, result.packageName, SupportedApps.findByPackage(result.packageName)?.keyCount ?: 21)
                }
            }
        }
    }
}

