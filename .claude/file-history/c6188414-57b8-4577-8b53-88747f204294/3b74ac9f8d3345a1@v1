@Composable
private fun SearchBar(query: String, onQueryChange: (String) -> Unit, modifier: Modifier = Modifier) {
    TextField(
        value = query,
        onValueChange = onQueryChange,
        modifier = modifier.fillMaxWidth().clip(RoundedCornerShape(16.dp)),
        placeholder = { Text("搜索音乐...", color = TextHint) },
        leadingIcon = { Icon(Icons.Default.Search, contentDescription = null, tint = TextHint) },
        colors = TextFieldDefaults.colors(
            focusedContainerColor = SurfaceLight,
            unfocusedContainerColor = SurfaceLight,
            focusedTextColor = TextPrimary,
            unfocusedTextColor = TextPrimary,
            cursorColor = PrimaryPurple,
            focusedIndicatorColor = Color.Transparent,
            unfocusedIndicatorColor = Color.Transparent
        ),
        singleLine = true
    )
}

@Composable
private fun TagFilterRow(tags: List<String>, selectedTag: String, onTagClick: (String) -> Unit) {
    LazyRow(
        contentPadding = PaddingValues(horizontal = 16.dp, vertical = 4.dp),
        horizontalArrangement = Arrangement.spacedBy(8.dp)
    ) {
        items(tags) { tag ->
            FilterChip(
                selected = tag == selectedTag,
                onClick = { onTagClick(tag) },
                label = { Text(tag, style = MaterialTheme.typography.labelMedium) },
                colors = FilterChipDefaults.filterChipColors(
                    selectedContainerColor = PrimaryPurple,
                    selectedLabelColor = Color.White,
                    containerColor = SurfaceLight,
                    labelColor = TextSecondary
                ),
                shape = RoundedCornerShape(20.dp),
                border = FilterChipDefaults.filterChipBorder(
                    borderColor = Color.Transparent,
                    selectedBorderColor = PrimaryPurpleLight,
                    enabled = true,
                    selected = tag == selectedTag
                )
            )
        }
    }
}

@Composable
private fun MusicCard(music: MusicEntity, isCurrentlyPlaying: Boolean, onClick: () -> Unit) {
    val tags = remember(music.tags) { music.getTagList() }

    Card(
        modifier = Modifier.fillMaxWidth().clickable(onClick = onClick),
        colors = CardDefaults.cardColors(
            containerColor = if (isCurrentlyPlaying) PrimaryPurple.copy(alpha = 0.15f) else SurfaceDark
        ),
        shape = RoundedCornerShape(16.dp),
        elevation = CardDefaults.cardElevation(defaultElevation = if (isCurrentlyPlaying) 8.dp else 2.dp),
        border = if (isCurrentlyPlaying) androidx.compose.foundation.BorderStroke(1.dp, PrimaryPurpleLight) else null
    ) {
        Row(
            modifier = Modifier.padding(14.dp).fillMaxWidth(),
            verticalAlignment = Alignment.CenterVertically,
            horizontalArrangement = Arrangement.SpaceBetween
        ) {
            Row(
                verticalAlignment = Alignment.CenterVertically,
                horizontalArrangement = Arrangement.spacedBy(14.dp),
                modifier = Modifier.weight(1f)
            ) {
                // 图标区域
                Box(
                    modifier = Modifier.size(50.dp).clip(RoundedCornerShape(12.dp))
                        .background(if (isCurrentlyPlaying) Brush.linearGradient(listOf(PrimaryPurpleLight, SecondaryCyan)) else Brush.linearGradient(listOf(PrimaryPurple, SecondaryCyan))),
                    contentAlignment = Alignment.Center
                ) {
                    if (isCurrentlyPlaying) PlayingAnimation() else Icon(Icons.Default.PlayArrow, contentDescription = null, tint = Color.White, modifier = Modifier.size(26.dp))
                }

                Column(modifier = Modifier.fillMaxWidth(0.75f)) {
                    Text(
                        text = music.title,
                        style = MaterialTheme.typography.titleMedium,
                        color = if (isCurrentlyPlaying) PrimaryPurpleLight else TextPrimary,
                        fontWeight = FontWeight.Bold,
                        maxLines = 2,
                        overflow = TextOverflow.Ellipsis
                    )

                    Spacer(modifier = Modifier.height(4.dp))

                    // 标签显示
                    if (tags.isNotEmpty()) {
                        Row(horizontalArrangement = Arrangement.spacedBy(6.dp)) {
                            tags.take(3).forEach { tag ->
                                Surface(
                                    shape = RoundedCornerShape(6.dp),
                                    color = PrimaryPurple.copy(alpha = 0.12f)
                                ) {
                                    Text(
                                        text = tag,
                                        style = MaterialTheme.typography.labelSmall,
                                        color = PrimaryPurpleLight,
                                        modifier = Modifier.padding(horizontal = 6.dp, vertical = 2.dp)
                                    )
                                }
                            }
                            if (tags.size > 3) {
                                Text(
                                    text = "+${tags.size - 3}",
                                    style = MaterialTheme.typography.labelSmall,
                                    color = TextHint
                                )
                            }
                        }
                    }

                    Spacer(modifier = Modifier.height(2.dp))
                    Text(text = music.fileName, style = MaterialTheme.typography.bodySmall, color = TextHint, maxLines = 1, overflow = TextOverflow.Ellipsis)
                }
            }

            Surface(
                onClick = onClick, shape = CircleShape,
                color = if (isCurrentlyPlaying) PrimaryPurpleLight else PrimaryPurple.copy(alpha = 0.3f)
            ) {
                Icon(
                    Icons.Default.PlayArrow,
                    contentDescription = if (isCurrentlyPlaying) "暂停" else "播放",
                    tint = if (isCurrentlyPlaying) BackgroundDark else PrimaryPurpleLight,
                    modifier = Modifier.padding(10.dp).size(22.dp)
                )
            }
        }
    }
}

@Composable
private fun PlayingAnimation() {
    Row(horizontalArrangement = Arrangement.spacedBy(2.dp), verticalAlignment = Alignment.CenterVertically, modifier = Modifier.height(20.dp)) {
        repeat(3) { index ->
            val transition = rememberInfiniteTransition(label = "bar$index")
            val height by transition.animateFloat(
                initialValue = 4f, targetValue = 18f,
                animationSpec = infiniteRepeatable(tween(400 + index * 100, easing = FastOutSlowInEasing), RepeatMode.Reverse),
                label = "h$index"
            )
            Box(modifier = Modifier.width(3.dp).height(height.dp).clip(RoundedCornerShape(1.5.dp)).background(Color.White))
        }
    }
}

