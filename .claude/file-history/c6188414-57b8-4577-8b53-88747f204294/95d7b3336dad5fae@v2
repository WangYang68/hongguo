package com.example.magicpinao.core.utils

import android.util.Log
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.withContext
import java.util.*
import javax.mail.*
import javax.mail.internet.InternetAddress
import javax.mail.internet.MimeMessage

/**
 * 邮件发送器 - 用于发送注册/重置密码验证码
 * 使用 QQ邮箱 SMTP 服务
 */
object EmailSender {

    private const val TAG = "EmailSender"

    // QQ邮箱 SMTP 配置
    private const val SMTP_HOST = "smtp.qq.com"
    private const val SMTP_PORT = "465"
    private const val SENDER_EMAIL = "magicpianoplayer@foxmail.com"
    private const val SENDER_PASSWORD = "xzwdpufqrbribhgd" // QQ邮箱授权码
    private const val SENDER_NAME = "MagicPiano魔琴"

    /**
     * 发送验证码邮件
     * @param recipientEmail 收件人邮箱
     * @return 生成的6位验证码，失败返回null
     */
    suspend fun sendVerificationCode(recipientEmail: String): String? {
        return withContext(Dispatchers.IO) {
            try {
                val code = generateCode()
                val sent = sendEmail(recipientEmail, code)
                if (sent) code else null
            } catch (e: Exception) {
                Log.e(TAG, "Send verification code error: ${e.message}", e)
                null
            }
        }
    }

    /**
     * 发送重置密码验证码
     */
    suspend fun sendResetPasswordCode(recipientEmail: String): String? {
        return withContext(Dispatchers.IO) {
            try {
                val code = generateCode()
                val sent = sendResetEmail(recipientEmail, code)
                if (sent) code else null
            } catch (e: Exception) {
                Log.e(TAG, "Send reset password code error: ${e.message}", e)
                null
            }
        }
    }

    /**
     * 生成6位随机数字验证码
     */
    private fun generateCode(): String {
        return (100000..999999).random().toString()
    }

    /**
     * 发送注册验证码邮件
     */
    private fun sendEmail(recipientEmail: String, code: String): Boolean {
        return try {
            val props = Properties().apply {
                put("mail.smtp.host", SMTP_HOST)
                put("mail.smtp.port", SMTP_PORT)
                put("mail.smtp.auth", "true")
                put("mail.smtp.ssl.enable", "true")
                put("mail.smtp.ssl.trust", SMTP_HOST)
                put("mail.smtp.connectiontimeout", "10000")
                put("mail.smtp.timeout", "10000")
                put("mail.smtp.writetimeout", "10000")
            }

            val session = Session.getInstance(props, object : Authenticator() {
                override fun getPasswordAuthentication(): PasswordAuthentication {
                    return PasswordAuthentication(SENDER_EMAIL, SENDER_PASSWORD)
                }
            })

            val message = MimeMessage(session).apply {
                setFrom(InternetAddress(SENDER_EMAIL, SENDER_NAME))
                setRecipient(Message.RecipientType.TO, InternetAddress(recipientEmail))
                subject = "MagicPiano魔琴 - 注册验证码"
                setContent(buildHtmlContent(code, "注册"), "text/html; charset=UTF-8")
            }

            Transport.send(message)
            Log.d(TAG, "Verification email sent to $recipientEmail")
            true
        } catch (e: Exception) {
            Log.e(TAG, "Failed to send email: ${e.message}", e)
            false
        }
    }

    /**
     * 发送重置密码验证码
     */
    private fun sendResetEmail(recipientEmail: String, code: String): Boolean {
        return try {
            val props = Properties().apply {
                put("mail.smtp.host", SMTP_HOST)
                put("mail.smtp.port", SMTP_PORT)
                put("mail.smtp.auth", "true")
                put("mail.smtp.ssl.enable", "true")
                put("mail.smtp.ssl.trust", SMTP_HOST)
                put("mail.smtp.connectiontimeout", "10000")
                put("mail.smtp.timeout", "10000")
                put("mail.smtp.writetimeout", "10000")
            }

            val session = Session.getInstance(props, object : Authenticator() {
                override fun getPasswordAuthentication(): PasswordAuthentication {
                    return PasswordAuthentication(SENDER_EMAIL, SENDER_PASSWORD)
                }
            })

            val message = MimeMessage(session).apply {
                setFrom(InternetAddress(SENDER_EMAIL, SENDER_NAME))
                setRecipient(Message.RecipientType.TO, InternetAddress(recipientEmail))
                subject = "MagicPiano魔琴 - 重置密码验证码"
                setContent(buildHtmlContent(code, "重置密码"), "text/html; charset=UTF-8")
            }

            Transport.send(message)
            Log.d(TAG, "Reset password email sent to $recipientEmail")
            true
        } catch (e: Exception) {
            Log.e(TAG, "Failed to send reset email: ${e.message}", e)
            false
        }
    }

    /**
     * 构建HTML邮件内容
     */
    private fun buildHtmlContent(code: String, action: String): String {
        return """
            <!DOCTYPE html>
            <html>
            <head><meta charset="UTF-8"></head>
            <body style="font-family: Arial, sans-serif; background: #0F0F1E; padding: 20px;">
                <div style="max-width: 480px; margin: 0 auto; background: #1A1A2E; border-radius: 16px; padding: 32px; border: 1px solid #6C5CE7;">
                    <div style="text-align: center; margin-bottom: 24px;">
                        <h1 style="color: #6C5CE7; margin: 0; font-size: 28px;">🎹 MagicPiano 魔琴</h1>
                        <p style="color: #A29BFE; font-size: 14px; margin-top: 8px;">$action 验证码</p>
                    </div>
                    <div style="text-align: center; background: linear-gradient(135deg, #6C5CE7, #00CEC9); border-radius: 12px; padding: 24px; margin: 20px 0;">
                        <span style="font-size: 48px; font-weight: bold; color: white; letter-spacing: 12px;">$code</span>
                    </div>
                    <p style="color: #E0E0E0; font-size: 14px; text-align: center; line-height: 1.6;">
                        您正在进行 $action 操作<br>
                        验证码有效期为 <span style="color: #FD79A8; font-weight: bold;">5分钟</span>，请尽快使用<br>
                        如非本人操作，请忽略此邮件
                    </p>
                    <hr style="border: none; border-top: 1px solid #252542; margin: 20px 0;">
                    <p style="color: #A0A0A0; font-size: 12px; text-align: center;">
                        MagicPiano 魔琴自动演奏系统
                    </p>
                </div>
            </body>
            </html>
        """.trimIndent()
    }
}
