/**
 * 坐标标定服务 — 两阶段：
 * 阶段1: 显示"开始标定"触发按钮（悬浮在所有应用之上）
 * 阶段2: 用户进入目标App后点击按钮 → 显示标定覆盖层
 */
class FloatingCalibrationService : Service() {

    companion object {
        private const val TAG = "FloatingCalibration"
        private const val NOTIFICATION_ID = 1001
        private const val CHANNEL_ID = "calibration_channel"

        const val ACTION_START_CALIBRATION = "ACTION_START_CALIBRATION"
        const val ACTION_STOP_CALIBRATION = "ACTION_STOP_CALIBRATION"
        const val EXTRA_PACKAGE_NAME = "EXTRA_PACKAGE_NAME"
        const val EXTRA_KEY_COUNT = "EXTRA_KEY_COUNT"
        const val EXTRA_LAYOUT_TYPE = "EXTRA_LAYOUT_TYPE"

        var instance: FloatingCalibrationService? = null
            private set

        fun start(context: Context, packageName: String, keyCount: Int = 21, layoutType: String = "LAYOUT_21") {
            val intent = Intent(context, FloatingCalibrationService::class.java).apply {
                action = ACTION_START_CALIBRATION
                putExtra(EXTRA_PACKAGE_NAME, packageName)
                putExtra(EXTRA_KEY_COUNT, keyCount)
                putExtra(EXTRA_LAYOUT_TYPE, layoutType)
            }
            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
                context.startForegroundService(intent)
            } else {
                context.startService(intent)
            }
        }

        fun stop(context: Context) {
            val intent = Intent(context, FloatingCalibrationService::class.java).apply {
                action = ACTION_STOP_CALIBRATION
            }
            context.startService(intent)
        }
    }

    private enum class Phase { TRIGGER, CALIBRATE }
    private var phase = Phase.TRIGGER

    private var wm: WindowManager? = null
    private var triggerBtn: View? = null    // "开始标定"按钮
    private var controlPanel: View? = null   // 控制面板（布局切换+完成+取消）
    private var overlayView: View? = null    // 标定覆盖层（标记+外框）

    private val scope = CoroutineScope(Dispatchers.Main + SupervisorJob())
    private val handler = Handler(Looper.getMainLooper())

    private var pianoLayout: PianoLayout = PianoLayouts.LAYOUT_21
    private var layoutType = PianoLayoutType.LAYOUT_21
    private var totalKeys = 21
    private var currentAppPackage = ""

    data class KeyMarker(
        val keyIndex: Int, var x: Float = 0f, var y: Float = 0f, val label: String = ""
    )
    private val markers = mutableListOf<KeyMarker>()

    private var tvStep: TextView? = null
    private var etSchemeName: EditText? = null

    // 触发按钮拖动
    private var btnX = 0; private var btnY = 120
    private var btnTouchStartX = 0f; private var btnTouchStartY = 0f

    // 控制面板拖动
    private var panelStartX = 0; private var panelStartY = 0
    private var panelTouchStartX = 0f; private var panelTouchStartY = 0f

    override fun onCreate() { super.onCreate(); instance = this }
    override fun onBind(intent: Intent?): IBinder? = null

    override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {
        when (intent?.action) {
            ACTION_START_CALIBRATION -> {
                currentAppPackage = intent.getStringExtra(EXTRA_PACKAGE_NAME) ?: ""
                totalKeys = intent.getIntExtra(EXTRA_KEY_COUNT, 21)
                val lt = intent.getStringExtra(EXTRA_LAYOUT_TYPE) ?: "LAYOUT_21"
                layoutType = try { PianoLayoutType.valueOf(lt) } catch (_: Exception) { PianoLayoutType.LAYOUT_21 }
                pianoLayout = PianoLayouts.getLayout(layoutType)
                startForegroundNotification()
                showTriggerButton()
            }
            ACTION_STOP_CALIBRATION -> { cleanup(); stopSelf() }
        }
        return START_NOT_STICKY
    }

    override fun onDestroy() { cleanup(); instance = null; scope.cancel(); super.onDestroy() }

    private fun cleanup() {
        try { controlPanel?.let { wm?.removeView(it) } } catch (_: Exception) {}
        controlPanel = null
        // 委托给无障碍服务清理
        PianoAccessibilityService.instance?.hideCalibrationTrigger()
        PianoAccessibilityService.instance?.hideCalibrationOverlay()
    }

    private fun startForegroundNotification() {
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
            val ch = NotificationChannel(CHANNEL_ID, "坐标标定", NotificationManager.IMPORTANCE_LOW)
            getSystemService(NotificationManager::class.java).createNotificationChannel(ch)
            startForeground(NOTIFICATION_ID, NotificationCompat.Builder(this, CHANNEL_ID)
                .setContentTitle("坐标标定 - ${layoutType.label}")
                .setContentText("在目标应用中点击「开始标定」按钮")
                .setSmallIcon(R.mipmap.ic_launcher).setOngoing(true).build())
        }
    }

    // ===== 阶段1：触发按钮（委托给无障碍服务） =====

    private fun showTriggerButton() {
        phase = Phase.TRIGGER
        initDefaultMarkers()

        val acc = PianoAccessibilityService.instance
        if (acc != null) {
            acc.showCalibrationTrigger(layoutType.label, totalKeys) {
                phase = Phase.CALIBRATE
                showCalibrationUI()
            }
            Toast.makeText(this, "请打开「${getAppName()}」进入钢琴界面，点击悬浮按钮开始标定", Toast.LENGTH_LONG).show()
        } else {
            Toast.makeText(this, "请先开启无障碍服务", Toast.LENGTH_LONG).show()
            stopSelf()
        }
    }

    // ===== 阶段2：标定UI =====

    private fun showCalibrationUI() {
        initDefaultMarkers()
        // 通过无障碍服务显示覆盖层
        val acc = PianoAccessibilityService.instance
        acc?.showCalibrationOverlay(markers, layoutType.label)
        // 控制面板仍用 TYPE_APPLICATION_OVERLAY（小面板，不会干扰）
        createControlPanel()
    }

    private fun createControlPanel() {
        wm = getSystemService(WINDOW_SERVICE) as WindowManager
        val lp = WindowManager.LayoutParams().apply {
            type = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O)
                WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY
            else @Suppress("DEPRECATION") WindowManager.LayoutParams.TYPE_PHONE
            flags = WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or
                    WindowManager.LayoutParams.FLAG_NOT_TOUCH_MODAL
            format = PixelFormat.TRANSLUCENT
            width = WindowManager.LayoutParams.WRAP_CONTENT
            height = WindowManager.LayoutParams.WRAP_CONTENT
            gravity = Gravity.BOTTOM or Gravity.CENTER_HORIZONTAL
            y = dp2px(60)
        }

        controlPanel = LayoutInflater.from(this).inflate(R.layout.floating_calibration_view, null)
        tvStep = controlPanel?.findViewById(R.id.tvStep)
        val btnReset = controlPanel?.findViewById<LinearLayout>(R.id.btnCalibrate)
        val btnFinish = controlPanel?.findViewById<LinearLayout>(R.id.btnFinish)
        val btnCancel = controlPanel?.findViewById<LinearLayout>(R.id.btnCancel)
        val dragHandle = controlPanel?.findViewById<LinearLayout>(R.id.dragHandle)

        updatePanelText()

        // 布局切换按钮
        addLayoutButtons()
        addSchemeInput()

        val resetText = controlPanel?.findViewById<TextView>(R.id.btn_calibrate_text)
        resetText?.text = "重置"
        btnReset?.setOnClickListener {
            initDefaultMarkers(); createOverlay(); Toast.makeText(this, "已重置", Toast.LENGTH_SHORT).show()
        }
        btnFinish?.setOnClickListener { saveCalibration() }
        btnCancel?.setOnClickListener {
            cleanup()
            showTriggerButton()
            Toast.makeText(this, "已取消", Toast.LENGTH_SHORT).show()
        }

        dragHandle?.setOnTouchListener { _, event ->
            when (event.action) {
                android.view.MotionEvent.ACTION_DOWN -> {
                    panelStartX = lp.x; panelStartY = lp.y
                    panelTouchStartX = event.rawX; panelTouchStartY = event.rawY
                    true
                }
                android.view.MotionEvent.ACTION_MOVE -> {
                    lp.x = panelStartX + (event.rawX - panelTouchStartX).toInt()
                    lp.y = panelStartY - (event.rawY - panelTouchStartY).toInt()
                    controlPanel?.let { wm?.updateViewLayout(it, lp) }
                    true
                }
                else -> false
            }
        }

        wm?.addView(controlPanel, lp)
    }

    private fun createOverlay() {
        // 委托给无障碍服务刷新覆盖层
        PianoAccessibilityService.instance?.showCalibrationOverlay(markers, layoutType.label)
    }

    // ===== UI 辅助 =====

    private fun addLayoutButtons() {
        val panel = controlPanel?.findViewById<LinearLayout>(R.id.rootLayout) ?: return
        val stepIdx = (0 until panel.childCount).firstOrNull { panel.getChildAt(it).id == R.id.tvStep } ?: return

        val row = LinearLayout(this).apply {
            orientation = LinearLayout.HORIZONTAL
            layoutParams = LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, LinearLayout.LayoutParams.WRAP_CONTENT).apply { bottomMargin = dp2px(8) }
        }
        PianoLayoutType.entries.forEach { t ->
            val btn = TextView(this).apply {
                text = when (t) { PianoLayoutType.LAYOUT_21 -> "21键"; PianoLayoutType.LAYOUT_36 -> "36键"; PianoLayoutType.LAYOUT_15 -> "15键" }
                textSize = 11f; gravity = android.view.Gravity.CENTER
                setPadding(dp2px(8), dp2px(4), dp2px(8), dp2px(4))
                layoutParams = LinearLayout.LayoutParams(0, LinearLayout.LayoutParams.WRAP_CONTENT, 1f)
                setOnClickListener {
                    layoutType = t; pianoLayout = PianoLayouts.getLayout(t)
                    totalKeys = when (t) { PianoLayoutType.LAYOUT_21 -> 21; PianoLayoutType.LAYOUT_36 -> 36; PianoLayoutType.LAYOUT_15 -> 15 }
                    initDefaultMarkers(); createOverlay(); updatePanelText()
                    updateLayoutBtnStyles(row)
                    startForegroundNotification()
                    Toast.makeText(this@FloatingCalibrationService, "已切换: ${t.label}", Toast.LENGTH_SHORT).show()
                }
            }
            row.addView(btn)
        }
        panel.addView(row, stepIdx + 1)
        updateLayoutBtnStyles(row)
    }

    private fun updateLayoutBtnStyles(row: LinearLayout) {
        for (i in 0 until row.childCount) {
            val btn = row.getChildAt(i) as? TextView ?: continue
            val active = PianoLayoutType.entries.getOrNull(i) == layoutType
            btn.setBackgroundResource(if (active) R.drawable.btn_speed_active_bg else R.drawable.btn_speed_bg)
            btn.setTextColor(if (active) 0xFFFFFFFF.toInt() else 0x80FFFFFF.toInt())
        }
    }

    private fun addSchemeInput() {
        val panel = controlPanel?.findViewById<LinearLayout>(R.id.rootLayout) ?: return
        val idx = (0 until panel.childCount).firstOrNull { panel.getChildAt(it).id == R.id.tvStep } ?: return
        etSchemeName = EditText(this).apply {
            hint = "方案名称（可选）"; setHintTextColor(0x60FFFFFF.toInt()); setTextColor(0xFFFFFFFF.toInt()); textSize = 12f
            setPadding(dp2px(8), dp2px(6), dp2px(8), dp2px(6))
            setBackgroundResource(R.drawable.btn_speed_bg)
            layoutParams = LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, LinearLayout.LayoutParams.WRAP_CONTENT).apply { bottomMargin = dp2px(8) }
        }
        panel.addView(etSchemeName, idx + 2)
    }

    private fun updatePanelText() {
        tvStep?.text = "${layoutType.label} | ${markers.size}键 | 拖动标记到琴键上"
    }

    // ===== 保存 =====

    private fun saveCalibration() {
        val coords = markers.mapIndexed { i, m ->
            val key = pianoLayout.getOrderedKeys().getOrNull(i)
            PianoKeyCoordinate(i, key?.midiNote ?: (48 + i), m.x.toInt(), m.y.toInt(), dp2px(30), dp2px(40))
        }
        scope.launch {
            try {
                val app = SupportedApps.findByPackage(currentAppPackage) ?: SupportedApps.getDefault()
                val repo = CoordinateRepository(applicationContext)
                val dm = resources.displayMetrics
                val name = etSchemeName?.text?.toString()?.trim()?.ifBlank {
                    val sdf = java.text.SimpleDateFormat("MMdd-HHmm", java.util.Locale.getDefault())
                    "${app.appName}-${layoutType.label}-${sdf.format(java.util.Date())}"
                } ?: "${app.appName}-${layoutType.label}"

                repo.saveCoordinate(CoordinateEntity(
                    deviceId = repo.generateDeviceId(currentAppPackage, dm.widthPixels, dm.heightPixels),
                    packageName = currentAppPackage, appName = app.appName,
                    screenWidth = dm.widthPixels, screenHeight = dm.heightPixels,
                    keyCount = totalKeys, calibrationMode = "DRAG_MARKERS",
                    schemeName = name, layoutType = layoutType.name,
                    keyCoordinates = Gson().toJson(coords)
                ))
                withContext(Dispatchers.Main) {
                    Toast.makeText(applicationContext, "方案「$name」已保存！", Toast.LENGTH_LONG).show()
                }
                delay(1000)
                withContext(Dispatchers.Main) { FloatingPlayerService.start(applicationContext, currentAppPackage) }
            } catch (e: Exception) {
                Log.e(TAG, "Save failed", e)
                withContext(Dispatchers.Main) { Toast.makeText(applicationContext, "保存失败: ${e.message}", Toast.LENGTH_LONG).show() }
            } finally { cleanup(); stopSelf() }
        }
    }

    // ===== 工具方法 =====

    private fun initDefaultMarkers() {
        markers.clear()
        val dm = resources.displayMetrics
        val kt = dm.heightPixels * 0.35f; val kb = dm.heightPixels * 0.88f
        val kl = dm.widthPixels * 0.05f; val kr = dm.widthPixels * 0.95f
        val keys = pianoLayout.getOrderedKeys()
        val perRow = keys.size / pianoLayout.rows
        keys.forEachIndexed { i, k ->
            val rh = (kb - kt) / pianoLayout.rows
            val kw = (kr - kl) / perRow
            markers.add(KeyMarker(i, kl + kw * (k.col + 0.5f), kb - rh * (k.row + 0.5f), k.label))
        }
    }

    private fun getAppName() = SupportedApps.findByPackage(currentAppPackage)?.appName ?: "目标应用"
    private fun dp2px(dp: Int) = (dp * resources.displayMetrics.density).toInt()
}

// ===== CalibrationOverlayView =====

class CalibrationOverlayView(context: Context) : View(context) {

    private val paintFrame = android.graphics.Paint().apply {
        color = Color.parseColor("#AA00CEC9"); style = android.graphics.Paint.Style.STROKE
        strokeWidth = 3f; isAntiAlias = true; pathEffect = android.graphics.DashPathEffect(floatArrayOf(16f, 8f), 0f)
    }
    private val paintFrameFill = android.graphics.Paint().apply { color = Color.parseColor("#0800CEC9"); style = android.graphics.Paint.Style.FILL; isAntiAlias = true }
    private val paintHandle = android.graphics.Paint().apply { color = Color.parseColor("#CC00CEC9"); style = android.graphics.Paint.Style.FILL; isAntiAlias = true }
    private val paintHandleStroke = android.graphics.Paint().apply { color = Color.parseColor("#FFFFFFFF"); style = android.graphics.Paint.Style.STROKE; strokeWidth = 2f; isAntiAlias = true }
    private val paintMarker = android.graphics.Paint().apply { color = Color.parseColor("#E06C5CE7"); style = android.graphics.Paint.Style.FILL; isAntiAlias = true }
    private val paintMarkerStroke = android.graphics.Paint().apply { color = Color.parseColor("#FFA29BFE"); style = android.graphics.Paint.Style.STROKE; strokeWidth = 3f; isAntiAlias = true }
    private val paintSel = android.graphics.Paint().apply { color = Color.parseColor("#FF00CEC9"); style = android.graphics.Paint.Style.STROKE; strokeWidth = 5f; isAntiAlias = true }
    private val paintText = android.graphics.Paint().apply { color = Color.WHITE; textSize = 22f; isAntiAlias = true; textAlign = android.graphics.Paint.Align.CENTER }
    private val paintLine = android.graphics.Paint().apply { color = Color.parseColor("#306C5CE7"); strokeWidth = 1.5f; isAntiAlias = true }
    private val paintHint = android.graphics.Paint().apply { color = Color.parseColor("#CCFFFFFF"); textSize = 30f; isAntiAlias = true; textAlign = android.graphics.Paint.Align.CENTER }

    private var markers: List<FloatingCalibrationService.KeyMarker> = emptyList()
    private val markerR = 28f; private val handleS = 24f

    var onMarkersChanged: ((List<FloatingCalibrationService.KeyMarker>) -> Unit)? = null

    private enum class Drag { NONE, MARKER, FRAME, H_TL, H_TR, H_BL, H_BR, H_ML, H_MR, H_MT, H_MB }
    private var drag = Drag.NONE; private var dragIdx = -1
    private var tsX = 0f; private var tsY = 0f
    private var startMarkers: List<Pair<Float, Float>> = emptyList()

    fun setMarkers(list: List<FloatingCalibrationService.KeyMarker>) { markers = list; invalidate() }

    private fun frame(): android.graphics.RectF {
        if (markers.isEmpty()) return android.graphics.RectF(100f, 300f, 900f, 1500f)
        val p = 70f
        return android.graphics.RectF(markers.minOf { it.x } - p, markers.minOf { it.y } - p, markers.maxOf { it.x } + p, markers.maxOf { it.y } + p)
    }

    private fun hitHandle(x: Float, y: Float, f: android.graphics.RectF): Drag {
        val h = handleS + 10f; val mx = f.centerX(); val my = f.centerY()
        if (android.graphics.RectF(f.left - h, f.top - h, f.left + h, f.top + h).contains(x, y)) return Drag.H_TL
        if (android.graphics.RectF(f.right - h, f.top - h, f.right + h, f.top + h).contains(x, y)) return Drag.H_TR
        if (android.graphics.RectF(f.left - h, f.bottom - h, f.left + h, f.bottom + h).contains(x, y)) return Drag.H_BL
        if (android.graphics.RectF(f.right - h, f.bottom - h, f.right + h, f.bottom + h).contains(x, y)) return Drag.H_BR
        if (android.graphics.RectF(f.left - h, my - h, f.left + h, my + h).contains(x, y)) return Drag.H_ML
        if (android.graphics.RectF(f.right - h, my - h, f.right + h, my + h).contains(x, y)) return Drag.H_MR
        if (android.graphics.RectF(mx - h, f.top - h, mx + h, f.top + h).contains(x, y)) return Drag.H_MT
        if (android.graphics.RectF(mx - h, f.bottom - h, mx + h, f.bottom + h).contains(x, y)) return Drag.H_MB
        if (f.contains(x, y)) return Drag.FRAME
        return Drag.NONE
    }

    private fun hitMarker(x: Float, y: Float): Int {
        for (i in markers.indices.reversed()) {
            val d = kotlin.math.sqrt(((x - markers[i].x) * (x - markers[i].x) + (y - markers[i].y) * (y - markers[i].y)).toDouble())
            if (d < markerR + 22f) return i
        }
        return -1
    }

    override fun onDraw(c: android.graphics.Canvas) {
        super.onDraw(c)
        c.drawColor(Color.parseColor("#08000000"))
        val f = frame()
        c.drawRect(f, paintFrameFill); c.drawRect(f, paintFrame)
        listOf(f.left to f.top, f.right to f.top, f.left to f.bottom, f.right to f.bottom,
            f.left to f.centerY(), f.right to f.centerY(), f.centerX() to f.top, f.centerX() to f.bottom
        ).forEach { (hx, hy) -> c.drawRect(hx - handleS, hy - handleS, hx + handleS, hy + handleS, paintHandle); c.drawRect(hx - handleS, hy - handleS, hx + handleS, hy + handleS, paintHandleStroke) }

        val pr = (markers.size / 3).coerceAtLeast(1)
        for (r in 0..2) {
            val rm = markers.filter { it.keyIndex / pr == r || (r == 2 && it.keyIndex / pr >= 2) }.sortedBy { it.x }
            for (i in 0 until rm.size - 1) c.drawLine(rm[i].x, rm[i].y, rm[i + 1].x, rm[i + 1].y, paintLine)
        }
        markers.forEachIndexed { i, m ->
            val rr = if (i == 0 && drag == Drag.MARKER && dragIdx == i) markerR + 8f else markerR
            c.drawCircle(m.x, m.y, rr, paintMarker); c.drawCircle(m.x, m.y, rr, paintMarkerStroke)
            if (drag == Drag.MARKER && dragIdx == i) c.drawCircle(m.x, m.y, rr + 4f, paintSel)
            c.drawText(m.label, m.x, m.y - rr - 10f, paintText)
        }
        c.drawText("拖动外框=整体调整 | 拖动手柄=缩放 | 拖动标记=微调", width / 2f, height * 0.06f, paintHint)
    }

    override fun onTouchEvent(e: android.view.MotionEvent): Boolean {
        val x = e.x; val y = e.y
        when (e.action) {
            android.view.MotionEvent.ACTION_DOWN -> {
                val mi = hitMarker(x, y)
                if (mi >= 0) { drag = Drag.MARKER; dragIdx = mi; tsX = x; tsY = y; startMarkers = listOf(markers[mi].x to markers[mi].y); invalidate(); return true }
                val h = hitHandle(x, y, frame())
                if (h != Drag.NONE) { drag = h; tsX = x; tsY = y; startMarkers = markers.map { it.x to it.y }; invalidate(); return true }
                return false
            }
            android.view.MotionEvent.ACTION_MOVE -> {
                if (drag == Drag.NONE) return false
                val dx = x - tsX; val dy = y - tsY
                when (drag) {
                    Drag.MARKER -> markers = markers.toMutableList().apply { set(dragIdx, get(dragIdx).copy(x = startMarkers[0].first + dx, y = startMarkers[0].second + dy)) }
                    Drag.FRAME -> markers = startMarkers.mapIndexed { i, (sx, sy) -> markers[i].copy(x = sx + dx, y = sy + dy) }
                    Drag.H_TL -> applyHandle(0f, 0f, dx, dy)
                    Drag.H_TR -> applyHandle(1f, 0f, dx, dy)
                    Drag.H_BL -> applyHandle(0f, 1f, dx, dy)
                    Drag.H_BR -> applyHandle(1f, 1f, dx, dy)
                    Drag.H_ML -> applyHandle(0f, 0.5f, dx, 0f)
                    Drag.H_MR -> applyHandle(1f, 0.5f, dx, 0f)
                    Drag.H_MT -> applyHandle(0.5f, 0f, 0f, dy)
                    Drag.H_MB -> applyHandle(0.5f, 1f, 0f, dy)
                    else -> {}
                }
                invalidate()
            }
            android.view.MotionEvent.ACTION_UP -> { if (drag != Drag.NONE) { drag = Drag.NONE; onMarkersChanged?.invoke(markers) } }
            android.view.MotionEvent.ACTION_CANCEL -> { drag = Drag.NONE }
        }
        return true
    }

    private fun applyHandle(hx: Float, hy: Float, dx: Float, dy: Float) {
        if (markers.size < 2) return
        val xs = startMarkers.map { it.first }; val ys = startMarkers.map { it.second }
        val ol = xs.min(); val or = xs.max(); val ot = ys.min(); val ob = ys.max()
        val ow = or - ol; val oh = ob - ot
        if (ow < 1f || oh < 1f) return
        val nl = if (hx == 0f) ol + dx else ol; val nr = if (hx == 1f) or + dx else or
        val nt = if (hy == 0f) ot + dy else ot; val nb = if (hy == 1f) ob + dy else ob
        val nL = minOf(nl, nr - 50f); val nR = maxOf(nr, nl + 50f)
        val nT = minOf(nt, nb - 50f); val nB = maxOf(nb, nt + 50f)
        val nw = nR - nL; val nh = nB - nT
        markers = startMarkers.mapIndexed { i, (sx, sy) ->
            markers[i].copy(x = nL + ((sx - ol) / ow).coerceIn(0f, 1f) * nw, y = nT + ((sy - ot) / oh).coerceIn(0f, 1f) * nh)
        }
    }
}
